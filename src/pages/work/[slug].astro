---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((study, index) => ({
    params: { slug: study.id },
    props: { study, index, total: entries.length, previous: entries[index - 1], next: entries[index + 1] },
  }));
}

const { study, index, total, previous, next } = Astro.props;
const { Content } = await render(study);
const { title, summary, kind, period, role, stack, facts, flow, images } = study.data;
const [hero, ...gallery] = images;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={title} description={summary}>
  <article class="container section study">
    <a class="back-link muted" href="/work/#selected-work">← All work</a>
    <p class="eyebrow">Work / Case study {pad(index + 1)} of {pad(total)}</p>
    <h1>{title}</h1>
    <p class="lead study-deck">{summary}</p>

    <dl class="study-meta">
      <div><dt>Role</dt><dd>{role}</dd></div>
      <div><dt>Type</dt><dd>{kind}</dd></div>
      <div><dt>When</dt><dd>{period}</dd></div>
    </dl>
    <ul class="tags" aria-label="Stack">{stack.map((item) => <li>{item}</li>)}</ul>

    <ul class="study-facts" aria-label="At a glance">
      {facts.map((fact) => <li><strong>{fact.value}</strong><span>{fact.label}</span></li>)}
    </ul>

    <figure class="study-flow" aria-labelledby={`${study.id}-flow-caption`}>
      <ol>
        {flow.map((step, i) => <li><span class="flow-index">{pad(i + 1)}</span><strong>{step.label}</strong>{step.note && <span class="muted">{step.note}</span>}</li>)}
      </ol>
      <figcaption id={`${study.id}-flow-caption`}><span class="flow-dot" aria-hidden="true"></span>How it fits together. Generic names, no internal systems.</figcaption>
    </figure>

    {hero && (
      <figure class="study-shot hero-shot">
        <Image src={hero.src} alt={hero.alt} widths={[720, 1080, 1440]} sizes="(max-width: 1100px) 100vw, 1100px" loading="eager" />
        <figcaption>{hero.caption}</figcaption>
      </figure>
    )}

    <div class="study-prose prose"><Content /></div>

    {gallery.length > 0 && (
      <section class="study-gallery" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading" class="eyebrow">More screens</h2>
        <div class="gallery-grid">
          {gallery.map((shot) => (
            <figure class="study-shot">
              <Image src={shot.src} alt={shot.alt} widths={[540, 720, 1080]} sizes="(max-width: 820px) 100vw, 540px" />
              <figcaption>{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <p class="study-note muted">Screens use demo or synthetic data. Names, identifiers and internal systems are invented, generalised or blurred. Numbers are approximate.</p>

    <nav class="study-pagination" aria-label="Case study navigation">
      {previous ? <a class="study-nav-card" href={`/work/${previous.id}/`}><span class="eyebrow muted">← Previous</span><strong>{previous.data.title}</strong></a> : <a class="study-nav-card" href="/work/"><span class="eyebrow muted">← Work overview</span><strong>Focus areas and toolbelt</strong></a>}
      {next ? <a class="study-nav-card next" href={`/work/${next.id}/`}><span class="eyebrow muted">Next →</span><strong>{next.data.title}</strong></a> : <a class="study-nav-card next" href="/work/#selected-work"><span class="eyebrow muted">That's all of them</span><strong>Back to selected work</strong></a>}
    </nav>
  </article>
</Base>

<style>
  .back-link { display: inline-block; margin-bottom: 2rem; text-decoration: none; }
  .study > h1 { max-width: 900px; }
  .study-deck { max-width: 760px; }
  .study-meta { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin: 2rem 0 1rem; }
  .study-meta dt { color: var(--muted); font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .study-meta dd { margin: .3rem 0 0; font-weight: 550; }
  .study-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; list-style: none; margin: 2.5rem 0 0; padding: 0; }
  .study-facts li { display: grid; gap: .35rem; padding: 1.2rem 1.3rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); }
  .study-facts strong { font-size: clamp(1.6rem, 3vw, 2.2rem); letter-spacing: -.03em; line-height: 1.1; color: var(--accent); }
  .study-facts span { color: var(--muted); font-size: .9rem; }
  .study-flow { margin: 2.5rem 0 0; }
  .study-flow ol { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 28px; list-style: none; margin: 0; padding: 1.4rem; border: 1px dashed var(--line); border-radius: 14px; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 22px 22px; background-color: var(--bg); }
  .study-flow li { position: relative; display: grid; gap: .3rem; align-content: start; padding: 1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); }
  .study-flow li:not(:last-child)::after { content: '→'; position: absolute; right: -21px; top: 50%; transform: translateY(-50%); color: var(--accent); font-family: var(--font-mono); }
  .study-flow li strong { font-size: .95rem; line-height: 1.3; }
  .study-flow li .muted { font-size: .8rem; line-height: 1.4; }
  .flow-index { color: var(--accent); font: 11px var(--font-mono); }
  .study-flow figcaption, .study-shot figcaption { display: flex; align-items: center; gap: 9px; padding-top: 12px; color: var(--muted); font: 12px/1.6 var(--font-mono); }
  .flow-dot { width: 6px; height: 6px; flex-shrink: 0; border-radius: 50%; background: var(--accent); }
  .study-shot { margin: 0; min-width: 0; }
  .study-shot :global(img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
  .hero-shot { margin-top: 3rem; }
  .study-prose { max-width: 760px; margin-top: 3rem; }
  .study-gallery { margin-top: 3.5rem; }
  .study-gallery h2 { margin: 0 0 1.2rem; font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem; }
  .study-note { margin-top: 3rem; max-width: 760px; font: 12px/1.7 var(--font-mono); }
  .study-pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2.5rem; }
  .study-nav-card { display: grid; gap: .55rem; padding: 1.2rem 1.4rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); color: var(--text); text-decoration: none; }
  .study-nav-card:hover { border-color: var(--accent); background: var(--soft); }
  .study-nav-card .eyebrow { font: 10px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; margin: 0; }
  .study-nav-card.next { text-align: right; }
  @media (max-width: 820px) {
    .gallery-grid { grid-template-columns: 1fr; }
    .study-flow ol { grid-template-columns: 1fr; gap: 22px; }
    .study-flow li:not(:last-child)::after { content: '↓'; right: auto; left: 1.2rem; top: auto; bottom: -21px; transform: none; }
  }
  @media (max-width: 520px) { .study-pagination { grid-template-columns: 1fr; } .study-nav-card.next { text-align: left; } }
</style>
