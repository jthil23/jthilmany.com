---
import Base from '../layouts/Base.astro';
import ServerIdentity from '../components/homelab/ServerIdentity.astro';
import ServiceConstellation from '../components/homelab/ServiceConstellation.astro';
import Pipeline from '../components/homelab/Pipeline.astro';
import ServiceLinkTag from '../components/homelab/ServiceLinkTag.astro';
import { categories, services, mediaPipeline, smartHomePipeline } from '../data/services';
const commandViews = ['Dashboard', 'Containers', 'Media', 'Storage', 'Automations', 'System', 'Logs', 'Settings'];
const commandServices = services.filter(service => ['plex', 'sonarr', 'home-assistant', 'mariadb', 'grafana', 'ollama'].includes(service.slug));
---
<Base title="SOL · Homelab" noindex description="Meet SOL: the Unraid server behind my media, smart home, local AI, and self-hosted experiments. Explore the real services and how they fit together.">
  <div class="container">
    <ServerIdentity />
    <ServiceConstellation />
    <section class="flows-section" aria-labelledby="flows-title">
      <div class="section-heading"><div><p class="eyebrow">03 / Useful systems</p><h2 id="flows-title">Small events.<br />Chain reactions.</h2></div><p class="flow-intro">The fun isn't collecting containers.<br />It's making them work together.</p></div>
      <Pipeline id="media-flow" title="From “can we watch this?” to play." kicker="The media pipeline" steps={mediaPipeline} caption="A simplified path through the media stack: a request becomes a tracked title, a download, an efficient file, subtitles, and something to watch. Sonarr handles series; Radarr handles movies alongside it." />
      <Pipeline id="home-flow" title="A house that connects the dots." kicker="The smart-home pipeline" steps={smartHomePipeline} caption="Zigbee device events enter through Zigbee2MQTT, travel over Mosquitto's MQTT broker, and feed Home Assistant. Node-RED adds visual flows when the automation needs more room. An illustrated flow, not a live event stream." />
    </section>
  </div>
  <section class="command-band" aria-labelledby="command-title">
    <div class="container command-layout">
      <div class="command-copy"><p class="eyebrow">04 / One place to bring it together</p><h2 id="command-title">The view<br />from the<br /><span>Command Center.</span></h2><p>A single pane of glass for SOL. Container management, media queues, storage, scheduled jobs, and automation controls—without bouncing between a dozen tabs.</p><p class="command-stack">Next.js 15 / React 19 / MariaDB / Docker</p><a class="button" href="https://github.com/jthil23/command-center" rel="noreferrer">Explore the repository ↗</a></div>
      <figure class="command-illustration" aria-label="Abstract Command Center interface illustration, not a live dashboard">
        <div class="window-bar"><span class="window-marks" aria-hidden="true"><i></i><i></i><i></i></span><span>COMMAND CENTER / SOL</span><span class="illustration-badge">Illustration</span></div>
        <div class="command-screen">
          <div class="command-nav" aria-hidden="true">{commandViews.map(view => <span class:list={{ active: view === 'Dashboard' }}>{view}</span>)}</div>
          <div class="command-content"><div class="mock-heading"><span>Dashboard</span><span>SOL</span></div><div class="mock-panels"><div><span>Storage</span><div class="abstract-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div></div><div><span>GPU</span><svg viewBox="0 0 140 70" role="img" aria-label="Abstract graphics card illustration"><rect x="12" y="15" width="113" height="40" rx="5" /><circle cx="44" cy="35" r="13" /><circle cx="90" cy="35" r="13" /><path d="M7 10v50m20-25h34m-17-17v34m29-17h34m-17-17v34" /></svg></div></div><p class="mock-label">Containers</p><div class="mock-containers">{commandServices.map(service => <div><img src={`/icons/services/${service.icon}`} width="28" height="28" alt={`${service.name} logo`} loading="lazy" /><span>{service.name}</span></div>)}</div><div class="mock-footer"><span>Automations</span><span>Activity feed</span></div></div>
        </div>
        <figcaption>Interface concept using real project views and service names. No live metrics or container status.</figcaption>
      </figure>
    </div>
  </section>
  <div class="container">
    <section class="directory-section" aria-labelledby="directory-title">
      <div class="section-heading"><div><p class="eyebrow">05 / The complete stack</p><h2 id="directory-title">Every piece has a job.</h2></div><span class="section-number">{services.length} real services</span></div>
      {categories.map((category, index) => <section class="directory-group" aria-labelledby={`directory-category-${index}`}>
        <div class="directory-heading"><span class="directory-index">{String(index + 1).padStart(2, '0')}</span><h3 id={`directory-category-${index}`}>{category.name}</h3><p>{category.blurb}</p></div>
        <div class="directory-grid">{services.filter(service => service.category === category.name).map(service => <article id={service.slug} class="directory-service">
          <div class="directory-logo"><img src={`/icons/services/${service.icon}`} width="36" height="36" alt={`${service.name} logo`} loading="lazy" /></div>
          <div><h4>{service.name}</h4><p>{service.description}</p><ServiceLinkTag service={service} /></div>
        </article>)}</div>
      </section>)}
    </section>
    <aside class="access-note" aria-labelledby="access-title"><span class="note-mark" aria-hidden="true">{'{ }'}</span><div><h2 id="access-title">A look inside. Not a way in.</h2><p>Links marked <strong>Home network</strong> open on my LAN or over Tailscale; everywhere else they don't resolve or are refused by Nginx Proxy Manager's access rules. Each service keeps its own login. This site makes no live status checks, and the illustrations aren't monitoring dashboards.</p><a class="text-link" href="/projects">See what I'm building on top of it ↗</a></div></aside>
  </div>
</Base>
<style>
  .flows-section { padding-block: 24px 80px; }
  .flows-section h2, .directory-section h2 { font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.08; letter-spacing: -.05em; }
  .flow-intro { color: var(--muted); font-size: .9rem; text-align: right; }
  .command-band { padding-block: 76px; border-block: 1px solid var(--line); background: radial-gradient(ellipse at 85% 50%, var(--ambient), transparent 65%), var(--soft); }
  .command-layout { display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; gap: 56px; }
  .command-copy h2 { font-size: clamp(2.6rem, 5vw, 4.4rem); line-height: 1.02; letter-spacing: -.055em; margin: 20px 0 24px; }
  .command-copy h2 span { color: var(--accent); }
  .command-copy > p:not(.eyebrow) { color: var(--muted); max-width: 45ch; }
  .command-copy .command-stack { font: .65rem var(--font-mono); margin: 24px 0; }
  .command-illustration { margin: 0; min-width: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 30px 70px var(--ambient); overflow: hidden; transform: rotate(-2deg); }
  .window-bar { display: flex; align-items: center; gap: 14px; padding: 16px; border-bottom: 1px solid var(--line); color: var(--muted); font: .55rem var(--font-mono); }
  .window-marks { display: flex; gap: 4px; }
  .window-marks i { width: 5px; height: 5px; border-radius: 50%; background: var(--line); }
  .illustration-badge { margin-left: auto; border: 1px solid var(--line); border-radius: 4px; padding: 4px 5px; }
  .command-screen { display: grid; grid-template-columns: 95px minmax(0, 1fr); min-height: 350px; }
  .command-nav { display: flex; flex-direction: column; gap: 6px; padding: 20px 10px; border-right: 1px solid var(--line); font-size: .55rem; color: var(--muted); }
  .command-nav span { padding: 6px; border-radius: 4px; }
  .command-nav .active { color: var(--accent); background: var(--soft); }
  .command-content { padding: 20px; min-width: 0; }
  .mock-heading { display: flex; justify-content: space-between; font-size: .95rem; font-weight: 650; }
  .mock-heading > span:last-child { color: var(--accent); font: .6rem var(--font-mono); }
  .mock-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-block: 20px; }
  .mock-panels > div { border: 1px solid var(--line); border-radius: 8px; padding: 12px; min-width: 0; }
  .mock-panels span, .mock-label, .mock-footer { font: .6rem var(--font-mono); color: var(--muted); }
  .abstract-bars { display: flex; align-items: end; height: 58px; gap: 6px; margin-top: 8px; }
  .abstract-bars i { width: 100%; height: 75%; background: var(--accent); border-radius: 3px; opacity: .35; }
  .abstract-bars i:nth-child(2n) { height: 45%; opacity: .7; }
  .abstract-bars i:nth-child(3n) { height: 90%; opacity: .5; }
  .mock-panels svg { width: 100%; height: 70px; fill: none; stroke: var(--accent); stroke-width: 1.5; }
  .mock-containers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .mock-containers > div { display: grid; place-items: center; gap: 8px; border-radius: 8px; padding: 12px 4px; background: var(--soft); color: var(--muted); min-width: 0; }
  .mock-containers img { object-fit: contain; }
  .mock-containers span { font-size: .5rem; text-align: center; overflow-wrap: anywhere; }
  .mock-footer { display: flex; justify-content: space-between; gap: 8px; padding-top: 20px; }
  .command-illustration figcaption { padding: 12px 16px; border-top: 1px solid var(--line); font-size: .6rem; color: var(--muted); }
  .directory-section { padding-block: 80px 40px; }
  .directory-group { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 36px; padding-block: 36px; border-top: 1px solid var(--line); }
  .directory-heading h3 { font-size: 1.25rem; line-height: 1.2; letter-spacing: -.03em; margin: 12px 0; }
  .directory-index { color: var(--accent); font: .7rem var(--font-mono); }
  .directory-heading p { font-size: .85rem; color: var(--muted); max-width: 26ch; margin: 0; }
  .directory-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px 22px; align-items: start; }
  .directory-service { display: flex; align-items: start; gap: 12px; min-width: 0; scroll-margin-top: 120px; border-radius: 8px; }
  .directory-service:target { outline: 2px solid var(--accent); outline-offset: 10px; }
  .directory-logo { display: grid; place-items: center; width: 48px; height: 48px; flex: 0 0 auto; border-radius: 12px; background: var(--soft); }
  .directory-logo img { object-fit: contain; }
  .directory-service h4 { font-size: .85rem; line-height: 1.3; margin: 4px 0 8px; }
  .directory-service p { font-size: .73rem; line-height: 1.65; color: var(--muted); margin: 0; }
  .directory-service a { display: inline-block; margin-top: 10px; font-size: .7rem; }
  .access-note { display: flex; align-items: start; gap: 28px; padding: 36px 0 72px; border-top: 1px solid var(--line); }
  .note-mark { color: var(--accent); font: 2rem var(--font-mono); white-space: nowrap; line-height: 1.4; }
  .access-note h2 { font-size: 1.3rem; margin: 0 0 12px; letter-spacing: -.03em; }
  .access-note p { color: var(--muted); max-width: 85ch; font-size: .87rem; margin-top: 0; }
  .access-note a { font-size: .85rem; }
  @media (max-width: 1050px) { .command-layout { gap: 32px; } .directory-group { grid-template-columns: 170px minmax(0, 1fr); gap: 24px; } .directory-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .command-illustration { transform: none; } }
  @media (max-width: 760px) { .command-layout { grid-template-columns: 1fr; gap: 40px; } .command-copy h2 { font-size: 3.2rem; } .command-illustration { max-width: 560px; width: 100%; } .directory-group { grid-template-columns: 1fr; gap: 24px; } .directory-heading p { max-width: none; } .flow-intro { text-align: left; } }
  @media (max-width: 520px) { .directory-grid { grid-template-columns: 1fr; gap: 24px; } .directory-logo { width: 52px; height: 52px; } .directory-service p { font-size: .82rem; } .directory-service h4 { font-size: .95rem; } .access-note { gap: 14px; } .note-mark { font-size: 1.2rem; } .command-screen { grid-template-columns: 72px minmax(0, 1fr); } .command-nav { padding-inline: 4px; } .command-content { padding: 14px; } .mock-panels { gap: 8px; } .mock-panels > div { padding: 8px; } .mock-containers { grid-template-columns: repeat(2, minmax(0, 1fr)); } .window-bar { gap: 8px; padding: 12px; font-size: .47rem; } .command-copy h2 { font-size: 2.8rem; } }
</style>
