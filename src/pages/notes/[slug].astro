---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  return (await getCollection('notes')).map(note=>({params:{slug:note.id},props:{note}}));
}
const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toISOString().slice(0, 10);
const formattedDate = note.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={note.data.title} description={note.data.description}><article class="container section prose"><p class="eyebrow">Field notes</p><h1>{note.data.title}</h1><p class="eyebrow muted"><time datetime={date}>{formattedDate}</time></p><p class="lead">{note.data.description}</p><Content /><div class="actions"><a href="/notes">← All notes</a></div></article></Base>
