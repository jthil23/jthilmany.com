---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { readingMinutes } from '../../lib/guide/readingTime';
const chapters = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
const totalMinutes = chapters.reduce((total, chapter) => total + readingMinutes(chapter.body), 0);
---
<Base title="Home server guide" description="A beginner-friendly guide to planning, building, and maintaining a home server.">
  <section class="container section guide-overview">
    <p class="eyebrow">A field guide / Home servers</p>
    <h1>Build a home server, <span>one step at a time.</span></h1>
    <p class="lead">Start with the why, then work through hardware, storage, apps, access, and care. No prior homelab experience required. Each chapter explains the idea before the choices you’ll make.</p>
    <p class="guide-meta muted">{chapters.length} chapters <span aria-hidden="true">·</span> about {totalMinutes} minutes of reading</p>
    <ol class="chapter-trail" aria-label="Home server guide chapters">
      {chapters.map((chapter, index) => (
        <li class="chapter-stop">
          <span class="stop-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <article class="chapter-card">
            <p class="eyebrow muted">Chapter {String(index + 1).padStart(2, '0')} <span aria-hidden="true">/</span> {readingMinutes(chapter.body)} min read</p>
            <h2><a href={`/guide/${chapter.id}/`}>{chapter.data.title}</a></h2>
            <p class="muted">{chapter.data.description}</p>
          </article>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .guide-overview h1 { max-width: 860px; }
  .guide-overview h1 span { color: var(--accent); }
  .guide-meta { margin-top: 1.5rem; font: 12px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .chapter-trail { list-style: none; padding: 0; margin: 3rem 0 0; }
  .chapter-stop { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1rem; padding-bottom: 1.5rem; }
  .chapter-stop:not(:last-child)::before { content: ''; position: absolute; left: 1.72rem; top: 3rem; bottom: 0; width: 1px; background: var(--line); }
  .stop-number { position: relative; z-index: 1; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border: 1px solid var(--accent); border-radius: 50%; background: var(--bg); color: var(--accent); font: 12px var(--font-mono); }
  .chapter-card { padding: 1.4rem 1.6rem; border: 1px solid var(--line); border-radius: 12px; background: color-mix(in srgb, var(--panel) 78%, transparent); }
  .chapter-card .eyebrow { font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; margin-bottom: .65rem; }
  .chapter-card h2 { margin: 0 0 .55rem; font-size: clamp(1.3rem, 2.5vw, 1.7rem); }
  .chapter-card h2 a { color: var(--text); text-decoration: none; }
  .chapter-card h2 a:hover { color: var(--accent); text-decoration: underline; }
  .chapter-card p:last-child { margin-bottom: 0; }
  @media (max-width: 520px) { .chapter-stop { grid-template-columns: 2.5rem minmax(0, 1fr); gap: .7rem; } .stop-number { width: 2.5rem; height: 2.5rem; font-size: 10px; } .chapter-stop:not(:last-child)::before { left: 1.23rem; top: 2.5rem; } .chapter-card { padding: 1rem; } }
</style>
