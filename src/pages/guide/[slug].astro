---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../lib/guide/readingTime';
export async function getStaticPaths() {
  const entries = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
  return Promise.all(entries.map(async (chapter, index) => {
    const { headings } = await render(chapter);
    return { params: { slug: chapter.id }, props: { chapter, headings, index, total: entries.length, previous: entries[index - 1], next: entries[index + 1] } };
  }));
}
const { chapter, headings, index, total, previous, next } = Astro.props;
const { Content } = await render(chapter);
const minutes = readingMinutes(chapter.body);
const chapterNumber = String(index + 1).padStart(2, '0');
const formattedUpdated = chapter.data.updated?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={chapter.data.title} description={chapter.data.description}>
  <article class="container section chapter-page">
    <a class="back-link muted" href="/guide/">← Back to the guide</a>
    <p class="eyebrow">Home server guide / {chapterNumber} of {String(total).padStart(2, '0')}</p>
    <h1>{chapter.data.title}</h1>
    <p class="lead chapter-deck">{chapter.data.description}</p>
    <p class="chapter-meta muted">{minutes} min read{formattedUpdated && <> <span aria-hidden="true">·</span> Updated <time datetime={chapter.data.updated?.toISOString().slice(0, 10)}>{formattedUpdated}</time></>}</p>
    <div class="chapter-layout">
      <nav class="chapter-toc" aria-label="Table of contents">
        <p class="eyebrow">On this page</p>
        <ol>{headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </nav>
      <div class="chapter-prose prose"><Content /></div>
    </div>
    <nav class="chapter-pagination" aria-label="Chapter navigation">
      {previous ? <a class="chapter-nav-card previous" href={`/guide/${previous.id}/`}><span class="eyebrow muted">← Previous chapter</span><strong>{previous.data.title}</strong></a> : <a class="chapter-nav-card previous" href="/guide/"><span class="eyebrow muted">← Guide overview</span><strong>All chapters</strong></a>}
      {next ? <a class="chapter-nav-card next" href={`/guide/${next.id}/`}><span class="eyebrow muted">Next chapter →</span><strong>{next.data.title}</strong></a> : <a class="chapter-nav-card next" href="/guide/"><span class="eyebrow muted">Finish the trail</span><strong>Back to the guide</strong></a>}
    </nav>
  </article>
</Base>
<style>
  .back-link { display: inline-block; margin-bottom: 2rem; text-decoration: none; }
  .chapter-page > h1 { max-width: 850px; }
  .chapter-deck { max-width: 700px; }
  .chapter-meta { margin-top: 1.2rem; font: 12px var(--font-mono); letter-spacing: .04em; }
  .chapter-layout { display: grid; grid-template-columns: minmax(180px, 230px) minmax(0, 760px); gap: clamp(2rem, 6vw, 5rem); align-items: start; margin-top: 3rem; }
  .chapter-toc { position: sticky; top: 150px; max-height: calc(100vh - 170px); overflow-y: auto; padding: 1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); }
  .chapter-toc .eyebrow { margin-bottom: .7rem; font: 11px var(--font-mono); text-transform: uppercase; }
  .chapter-toc ol { list-style: none; padding: 0; margin: 0; }
  .chapter-toc li { margin: .4rem 0; font-size: .86rem; line-height: 1.45; }
  .chapter-toc li.nested { padding-left: .8rem; }
  .chapter-toc a { color: var(--muted); text-decoration: none; }
  .chapter-toc a:hover, .chapter-toc a[aria-current="location"] { color: var(--accent); text-decoration: underline; }
  .chapter-prose { min-width: 0; }
  .chapter-prose :global(h2), .chapter-prose :global(h3) { scroll-margin-top: 160px; }
  .chapter-prose :global(.on-sol) { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 8px; padding: 1.2rem 1.4rem; background: var(--panel); }
  .chapter-prose :global(.on-sol h2) { margin-top: 0; font-size: 1.35rem; }
  .chapter-prose :global(.on-sol p:last-child) { margin-bottom: 0; }
  .chapter-prose :global(.on-sol + h2) { margin-top: 2.5rem; }
  .chapter-prose :global(h2[id]) { scroll-margin-top: 150px; }
  .chapter-pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 3rem auto 0; max-width: 1000px; }
  .chapter-nav-card { display: grid; gap: .55rem; padding: 1.2rem 1.4rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); color: var(--text); text-decoration: none; }
  .chapter-nav-card:hover { border-color: var(--accent); background: var(--soft); }
  .chapter-nav-card .eyebrow { font: 10px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; margin: 0; }
  .chapter-nav-card strong { line-height: 1.35; }
  .chapter-nav-card.next { text-align: right; }
  @media (max-width: 820px) { .chapter-layout { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; } .chapter-toc { position: static; max-height: none; } .chapter-toc ol { columns: 2; column-gap: 1.5rem; } }
  @media (max-width: 520px) { .chapter-pagination { grid-template-columns: 1fr; } .chapter-nav-card.next { text-align: left; } .chapter-toc ol { columns: 1; } }
</style>
<script>
  let cleanup: (() => void) | undefined;
  function mountChapterNavigation() {
    cleanup?.();
    cleanup = undefined;
    const root = document.querySelector<HTMLElement>('.chapter-page');
    if (!root) return;
    const controller = new AbortController();
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.chapter-toc a')];
    const headings = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((heading): heading is HTMLElement => heading instanceof HTMLElement);
    if ('IntersectionObserver' in window && headings.length) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((link) => {
          if (link.hash === `#${visible.target instanceof HTMLElement ? visible.target.id : ''}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-120px 0px -68% 0px' });
      headings.forEach((heading) => observer.observe(heading));
      cleanup = () => { observer.disconnect(); controller.abort(); };
    }
  }
  mountChapterNavigation();
  document.addEventListener('astro:page-load', mountChapterNavigation);
  document.addEventListener('astro:before-swap', () => cleanup?.());
  window.addEventListener('pagehide', () => cleanup?.());
  window.addEventListener('pageshow', (event) => { if (event.persisted) mountChapterNavigation(); });
</script>
