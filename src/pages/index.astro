<script>
  const dashboard = document.querySelector<HTMLElement>('[data-home-dashboard]');
  if (dashboard) {
    const buttons = dashboard.querySelectorAll<HTMLButtonElement>('[data-home-view]');
    const panels = dashboard.querySelectorAll<HTMLElement>('[data-home-panel]');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        panels.forEach((panel) => { panel.hidden = panel.dataset.homePanel !== button.dataset.homeView; });
      });
    });
  }
</script>
