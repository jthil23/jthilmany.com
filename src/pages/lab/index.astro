---
import Base from '../../layouts/Base.astro';
const contourPaths = Array.from({ length: 17 }, (_, ring) => {
  const points = Array.from({ length: 73 }, (_, point) => {
    const angle = point / 72 * Math.PI * 2;
    const radius = 17 + ring * 8.8;
    const wobble = 1 + Math.sin(angle * 3 + ring * .09) * .14 + Math.cos(angle * 5) * .07;
    return `${point === 0 ? 'M' : 'L'}${(275 + Math.cos(angle) * radius * wobble * 1.3).toFixed(1)} ${(158 + Math.sin(angle) * radius * wobble).toFixed(1)}`;
  });
  return `${points.join(' ')}Z`;
});
const switchbacks = 'M188 288C230 282 280 282 318 276S338 258 262 252 204 236 266 226 356 220 330 206 254 196 290 182 330 170 278 160';
const circuit = 'M118 262C66 262 52 196 98 176L214 128C252 112 246 64 298 62L438 70C500 74 512 140 462 160L384 190C352 202 360 240 402 250L434 258C474 270 456 304 414 304L166 304C134 304 118 288 118 262Z';
const racingLine = 'M126 256C78 252 70 200 106 184L218 136C258 118 252 74 300 72L434 80C488 84 498 136 456 152L380 182C340 198 350 246 398 258L428 266C460 276 448 296 414 296L170 296C140 296 126 282 126 256Z';
const flowNodes = [
  { x: 70, y: 170, icon: 'overseerr.svg' },
  { x: 175, y: 100, icon: 'sonarr.svg' },
  { x: 175, y: 240, icon: 'radarr.svg' },
  { x: 290, y: 170, icon: 'prowlarr.svg' },
  { x: 395, y: 170, icon: 'nzbget.svg' },
  { x: 495, y: 170, icon: 'plex.svg' },
];
const flowEdges = [[0, 1], [0, 2], [1, 3], [2, 3], [3, 4], [4, 5]] as const;
const experiments = [
  { href: '/lab/topo-trail/', number: '001', meta: 'Pathfinding · 3D', title: 'Topo trail', body: 'Drop a trailhead and a summit on real mountains or invented ones. Watch Dijkstra, A*, and Greedy search race to build a trail that respects a maximum grade, then flip it into 3D.', cta: 'Plan a trail' },
  { href: '/lab/racing-line/', number: '002', meta: 'Neuroevolution · F1', title: 'Racing line', body: 'This week’s Formula 1 circuit, a grid of tiny AI cars, and no instructions. Each generation the fastest survive and breed. Compare what they learn with the mathematically ideal line.', cta: 'Start the session' },
  { href: '/lab/request-flow/', number: '003', meta: 'Homelab · Animation', title: 'Request flow', body: 'What actually happens when someone requests a movie, a camera sees motion, or a voice says “turn on the lights”? Step through each hop on SOL, my home server.', cta: 'Follow a request' },
];
---
<Base title="Lab" description="Three hands-on browser experiments: trail pathfinding across real terrain, AI cars learning a Formula 1 racing line, and a walk-through of how requests move through a home server.">
  <section class="container section lab-gallery">
    <div class="gallery-heading"><div><p class="eyebrow">The lab / Small ideas, set loose</p><h1>No brief.<br />Just <span>curiosity.</span></h1></div><div class="gallery-note"><span class="note-symbol" aria-hidden="true">{'{ * }'}</span><p>Code can be useful.<br />It can also be a little wonder.</p><span class="local-note">Browser-native / No account / No install</span></div></div>
    <p class="lab-intro muted">Three experiments at the intersection of algorithms, the outdoors, racing, and the homelab. Each one shows its work, so you can see how it gets to the answer.</p>
    <div class="experiment-gallery">
      {experiments.map((experiment, index) => (
        <a class={`experiment-tile tile-${index + 1}`} href={experiment.href}>
          <div class="tile-preview" aria-hidden="true">
            {index === 0 && <>
              <span class="preview-label">Terrain + search / preview</span>
              <svg viewBox="0 0 560 340" fill="none"><g class="contour-lines" stroke="currentColor" stroke-width=".9">{contourPaths.map((path, ring) => <path d={path} opacity={ring % 4 === 0 ? '.75' : '.35'} />)}</g><path class="trail-shadow" d={switchbacks} /><path class="trail-line draw" pathLength="1" d={switchbacks} /><circle cx="188" cy="288" r="4" class="trail-end" /><circle cx="278" cy="160" r="5" class="trail-end summit" /></svg>
              <span class="preview-bottom">Max grade → switchbacks</span>
            </>}
            {index === 1 && <>
              <span class="preview-label">Circuit + learning / preview</span>
              <svg viewBox="0 0 560 340" fill="none"><path class="track-surface" d={circuit} /><path class="track-edge" d={circuit} /><path class="ideal-line draw" pathLength="1" d={racingLine} /><circle class="car car-lead" r="5" style={`offset-path: path('${racingLine}')`} /><circle class="car car-2" r="3.5" style={`offset-path: path('${racingLine}')`} /><circle class="car car-3" r="3.5" style={`offset-path: path('${racingLine}')`} /></svg>
              <span class="preview-bottom">Generation by generation → a faster line</span>
            </>}
            {index === 2 && <>
              <span class="preview-label">Service hops / preview</span>
              <svg viewBox="0 0 560 340" fill="none">
                <g class="flow-edges">{flowEdges.map(([from, to]) => <path d={`M${flowNodes[from].x} ${flowNodes[from].y}L${flowNodes[to].x} ${flowNodes[to].y}`} />)}</g>
                <circle class="packet" r="4" style={`offset-path: path('M${flowNodes[0].x} ${flowNodes[0].y}L${flowNodes[1].x} ${flowNodes[1].y}L${flowNodes[3].x} ${flowNodes[3].y}L${flowNodes[4].x} ${flowNodes[4].y}L${flowNodes[5].x} ${flowNodes[5].y}')`} />
                {flowNodes.map(node => <g><circle class="flow-node" cx={node.x} cy={node.y} r="26" /><image href={`/icons/services/${node.icon}`} x={node.x - 14} y={node.y - 14} width="28" height="28" /></g>)}
              </svg>
              <span class="preview-bottom">Request → automation → library</span>
            </>}
            <span class="preview-arrow">↗</span>
          </div>
          <div class="tile-content"><div class="tile-meta"><span>Lab / {experiment.number}</span><span>{experiment.meta}</span></div><h2>{experiment.title}</h2><p>{experiment.body}</p><span class="experiment-link">{experiment.cta} <span aria-hidden="true">→</span></span></div>
        </a>
      ))}
    </div>
    <div class="lab-footnote"><span aria-hidden="true">↳</span><p>No tracking inside the experiments and no server doing the work: everything runs in your browser. Real-world elevation for Topo trail is loaded from public terrain tiles. Previews above are illustrations; open an experiment to take control. Reduced motion is respected.</p></div>
  </section>
</Base>
<style>
  .gallery-heading { display: flex; justify-content: space-between; align-items: end; gap: 32px; }
  .gallery-heading h1 { margin-bottom: 0; }
  .gallery-note { padding-bottom: 12px; color: var(--muted); font-size: 14px; }
  .note-symbol { color: var(--accent); font: 32px var(--font-mono); }
  .local-note { display: block; font: 9px/1.7 var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
  .lab-intro { max-width: 590px; font-size: 1.1rem; margin-top: 28px; }
  .experiment-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; margin-top: 60px; align-items: start; }
  .experiment-tile { display: block; color: var(--text); text-decoration: none; min-width: 0; }
  .tile-2 { margin-top: 60px; }
  .tile-3 { margin-top: 120px; }
  .tile-preview { position: relative; border: 1px solid var(--line); overflow: hidden; background: radial-gradient(ellipse at center, var(--soft), var(--bg) 70%); border-radius: 12px; color: var(--accent); isolation: isolate; transition: border-color .25s, box-shadow .25s; }
  .tile-preview svg { width: 100%; height: auto; display: block; }
  .preview-label, .preview-bottom { position: absolute; left: 16px; z-index: 1; font: 9px var(--font-mono); color: var(--muted); }
  .preview-label { top: 16px; text-transform: uppercase; letter-spacing: .08em; padding: 6px 8px; background: var(--bg); border-radius: 3px; }
  .preview-bottom { bottom: 16px; }
  .preview-arrow { position: absolute; right: 16px; bottom: 10px; font-size: 25px; color: var(--text); transition: transform .25s; }
  .trail-shadow { stroke: var(--bg); stroke-width: 7px; }
  .trail-line { stroke: var(--text); stroke-width: 2px; stroke-linecap: round; stroke-linejoin: round; }
  .trail-end { fill: var(--bg); stroke: var(--text); stroke-width: 1.5px; }
  .summit { stroke: var(--accent); }
  .track-surface { stroke: var(--soft); stroke-width: 26px; stroke-linejoin: round; }
  .track-edge { stroke: currentColor; stroke-width: 1px; opacity: .45; }
  .ideal-line { stroke: var(--text); stroke-width: 1.6px; stroke-dasharray: 1; }
  .car { fill: var(--accent); offset-distance: 0%; }
  .car-lead { fill: var(--text); }
  .flow-edges path { stroke: currentColor; stroke-width: 1.4px; opacity: .45; }
  .flow-node { fill: var(--bg); stroke: currentColor; stroke-width: 1.2px; }
  .packet { fill: var(--text); offset-distance: 0%; }
  .tile-content { padding-top: 22px; }
  .tile-meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; color: var(--muted); font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: .07em; }
  .tile-meta span:first-child { color: var(--accent); }
  .tile-content h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -.045em; margin: 16px 0 10px; }
  .tile-content p { color: var(--muted); margin-top: 0; font-size: .95rem; }
  .experiment-link { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding: 16px 0; margin-top: 22px; color: var(--accent); font-size: 13px; font-weight: 600; }
  .experiment-tile:hover .tile-preview, .experiment-tile:focus-visible .tile-preview { border-color: var(--accent); box-shadow: 0 12px 44px var(--ambient); }
  .experiment-tile:hover .preview-arrow { transform: translate(3px, -3px); }
  .lab-footnote { display: flex; gap: 22px; align-items: baseline; border-top: 1px solid var(--line); margin-top: 55px; padding-top: 24px; color: var(--muted); }
  .lab-footnote > span { color: var(--accent); font-size: 28px; }
  .lab-footnote p { font-size: 12px; max-width: 740px; }
  @media (prefers-reduced-motion: no-preference) {
    .draw { animation: draw-in 3.5s ease-out both; }
    .car { animation: lap 7s linear infinite; }
    .car-2 { animation-delay: -1.1s; animation-duration: 7.6s; }
    .car-3 { animation-delay: -2.3s; animation-duration: 8.3s; }
    .packet { animation: hop 4.5s ease-in-out infinite; }
  }
  @keyframes draw-in { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  @keyframes lap { to { offset-distance: 100%; } }
  @keyframes hop { 0% { offset-distance: 0%; opacity: 0; } 8% { opacity: 1; } 90% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .tile-preview, .preview-arrow { transition: none; } .car-2 { offset-distance: 35%; } .car-3 { offset-distance: 62%; } .packet { offset-distance: 55%; } }
  @media (max-width: 1100px) { .experiment-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tile-3 { margin-top: 0; } }
  @media (max-width: 800px) { .gallery-heading { flex-direction: column; align-items: start; gap: 20px; } .gallery-note { display: none; } .experiment-gallery { gap: 26px; } .preview-label, .preview-bottom { left: 12px; font-size: 8px; } .preview-label { top: 12px; } .preview-bottom { bottom: 14px; } }
  @media (max-width: 600px) { .experiment-gallery { grid-template-columns: 1fr; margin-top: 38px; gap: 42px; } .tile-2 { margin-top: 0; } .tile-content { padding-top: 20px; } .lab-footnote { margin-top: 32px; gap: 12px; } }
</style>
