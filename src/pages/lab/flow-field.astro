---
import Base from '../../layouts/Base.astro';
---

<Base title="Flow field · Lab" description="An interactive canvas experiment: steer a thousand particles through a changing flow field.">
  <section class="container section">
    <a class="back-link muted" href="/lab/">← Back to the lab</a>
    <p class="eyebrow">Lab / 001</p>
    <h1>Follow the flow.</h1>
    <p class="experiment-intro muted">A thousand particles follow the same invisible field. Simple directions accumulate into something a little less predictable.</p>

    <div class="flow-experiment" data-flow-experiment>
      <div class="canvas-frame">
        <canvas data-flow-canvas aria-hidden="true"></canvas>
        <span class="canvas-label" aria-hidden="true">Flow field / live canvas</span>
      </div>
      <div class="flow-controls">
        <div class="action-controls">
          <button class="button" type="button" data-flow-toggle>Pause motion</button>
          <button class="button secondary" type="button" data-flow-reseed>New field</button>
        </div>
        <label class="control-label">
          <span>Color</span>
          <select data-flow-color>
            <option value="ice">Ice · electric blue</option>
            <option value="ember">Ember · orange</option>
            <option value="dusk">Dusk · violet</option>
          </select>
        </label>
        <label class="control-label speed-control">
          <span>Speed <output data-flow-speed-output>1.00×</output></span>
          <input data-flow-speed type="range" min="0.25" max="2" value="1" step="0.05" aria-label="Particle speed" />
        </label>
      </div>
      <p class="flow-status muted" data-flow-status role="status" aria-live="polite">Loading the experiment…</p>
      <noscript><p class="muted">This experiment needs JavaScript to draw the field. The rest of the site works without it.</p></noscript>
    </div>

    <div class="experiment-notes">
      <div>
        <h2>One rule, a thousand paths.</h2>
        <p class="muted">At every position, a few overlapping sine and cosine waves define a direction. Each particle takes a small step in that direction, leaving a fading trail. The field slowly changes over time, so the paths never quite settle.</p>
      </div>
      <div>
        <h2>Make it yours.</h2>
        <p class="muted">Choose a palette, adjust the speed, or use “New field” to change the starting conditions. Pause to keep a pattern on screen. Everything is drawn locally with the browser’s canvas API—no library or server involved.</p>
        <p class="muted">If your device requests reduced motion, the experiment starts as a still image. You can choose to resume. All controls work with a keyboard; use the arrow keys on the speed slider.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  const PARTICLES = 1000;
  const BACKGROUND = '#080f20';
  const palettes = {
    ice: ['#2563ff', '#65baff', '#a6e8ff'],
    ember: ['#ffb876', '#e87d62', '#ffe1ad'],
    dusk: ['#bdabff', '#8d84e8', '#edd4ff'],
  } as const;
  type Palette = keyof typeof palettes;
  let dispose: (() => void) | undefined;

  function mountFlowField() {
    dispose?.();
    dispose = undefined;
    const root = document.querySelector<HTMLElement>('[data-flow-experiment]');
    if (!root) return;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-flow-canvas]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-flow-toggle]');
    const reseed = root.querySelector<HTMLButtonElement>('[data-flow-reseed]');
    const color = root.querySelector<HTMLSelectElement>('[data-flow-color]');
    const speedInput = root.querySelector<HTMLInputElement>('[data-flow-speed]');
    const speedOutput = root.querySelector<HTMLOutputElement>('[data-flow-speed-output]');
    const status = root.querySelector<HTMLElement>('[data-flow-status]');
    if (!canvas || !toggle || !reseed || !color || !speedInput || !speedOutput || !status) return;
    const context = canvas.getContext('2d');
    if (!context) {
      status.textContent = 'Canvas is not available in this browser. You can still read how the experiment works below.';
      root.querySelectorAll<HTMLButtonElement | HTMLInputElement | HTMLSelectElement>('button, input, select').forEach(control => { control.disabled = true; });
      return;
    }

    const ctx = context;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const events = new AbortController();
    const x = new Float32Array(PARTICLES);
    const y = new Float32Array(PARTICLES);
    const ages = new Float32Array(PARTICLES);
    const seedBuffer = new Uint32Array(1);
    let width = 0;
    let height = 0;
    let seed = 0;
    let randomState = 0;
    let phase = 0;
    let fieldOffset = 0;
    let frequency = 0.006;
    let running = !motion.matches;
    let frame = 0;
    let previousTime = 0;
    let palette: Palette = 'ice';
    let speed = 1;
    let destroyed = false;

    function random() {
      randomState = (Math.imul(randomState, 1664525) + 1013904223) >>> 0;
      return randomState / 4294967296;
    }

    function resetParticle(index: number) {
      x[index] = random() * width;
      y[index] = random() * height;
      ages[index] = random() * 220;
    }

    function clear() {
      ctx.globalAlpha = 1;
      ctx.fillStyle = BACKGROUND;
      ctx.fillRect(0, 0, width, height);
    }

    function initializeParticles() {
      randomState = seed;
      phase = 0;
      fieldOffset = random() * Math.PI * 2;
      frequency = 0.004 + random() * 0.004;
      for (let index = 0; index < PARTICLES; index++) resetParticle(index);
      clear();
    }

    function drawStep(step: number, fade: boolean) {
      if (fade) {
        ctx.globalAlpha = 1;
        ctx.fillStyle = 'rgba(11, 21, 28, 0.055)';
        ctx.fillRect(0, 0, width, height);
      }
      ctx.lineWidth = 0.85;
      ctx.globalAlpha = 0.48;
      const colors = palettes[palette];
      // Three paths avoid a stroke call and color change for every particle.
      for (let group = 0; group < colors.length; group++) {
        ctx.beginPath();
        ctx.strokeStyle = colors[group];
        for (let index = group; index < PARTICLES; index += colors.length) {
          const oldX = x[index];
          const oldY = y[index];
          const angle = (Math.sin(oldX * frequency + phase) + Math.cos(oldY * frequency - phase * 0.7) + Math.sin((oldX + oldY) * frequency * 0.5 + fieldOffset)) * Math.PI;
          const nextX = oldX + Math.cos(angle) * step;
          const nextY = oldY + Math.sin(angle) * step;
          ages[index] += step;
          if (nextX < 0 || nextX > width || nextY < 0 || nextY > height || ages[index] > 450) {
            resetParticle(index);
            ages[index] = 0;
            continue;
          }
          ctx.moveTo(oldX, oldY);
          ctx.lineTo(nextX, nextY);
          x[index] = nextX;
          y[index] = nextY;
        }
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }

    function drawStill() {
      // A finite set of steps produces visible trails without starting animation.
      for (let step = 0; step < 36; step++) drawStep(1.6, false);
    }

    function updateStatus() {
      toggle!.textContent = running ? 'Pause motion' : 'Resume motion';
      status!.textContent = running
        ? 'Running · Change the field, color, or speed to explore.'
        : motion.matches
          ? 'Paused · Reduced motion is enabled. Resume only if you want animation.'
          : 'Paused · Your current pattern stays on screen.';
    }

    function animate(time: number) {
      frame = 0;
      if (destroyed || !running || document.hidden) return;
      const elapsed = previousTime ? Math.min((time - previousTime) / 16.667, 2) : 1;
      previousTime = time;
      const step = elapsed * speed * 1.45;
      phase += step * 0.0013;
      drawStep(step, true);
      frame = requestAnimationFrame(animate);
    }

    function stopFrame() {
      cancelAnimationFrame(frame);
      frame = 0;
      previousTime = 0;
    }

    function startFrame() {
      if (!destroyed && running && !document.hidden && !frame && width && height) {
        previousTime = 0;
        frame = requestAnimationFrame(animate);
      }
    }

    function resize() {
      const bounds = canvas!.getBoundingClientRect();
      const nextWidth = Math.round(bounds.width);
      const nextHeight = Math.round(bounds.height);
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      if (nextWidth <= 0 || nextHeight <= 0) return;
      if (nextWidth === width && nextHeight === height && canvas!.width === Math.round(nextWidth * ratio) && canvas!.height === Math.round(nextHeight * ratio)) return;
      width = nextWidth;
      height = nextHeight;
      canvas!.width = Math.round(width * ratio);
      canvas!.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      initializeParticles();
      drawStill();
      startFrame();
    }

    function newField() {
      seed = crypto.getRandomValues(seedBuffer)[0];
      initializeParticles();
      drawStill();
      status!.textContent = running ? 'New field · Motion is running.' : 'New field · Motion stays paused.';
    }

    toggle.addEventListener('click', () => {
      running = !running;
      if (running) startFrame();
      else stopFrame();
      updateStatus();
    }, { signal: events.signal });
    reseed.addEventListener('click', newField, { signal: events.signal });
    color.addEventListener('change', () => {
      const selected = color.value;
      if (!(selected in palettes)) return;
      palette = selected as Palette;
      initializeParticles();
      drawStill();
    }, { signal: events.signal });
    speedInput.addEventListener('input', () => {
      speed = Number(speedInput.value);
      speedOutput.value = `${speed.toFixed(2)}×`;
      speedInput.setAttribute('aria-valuetext', `${speed.toFixed(2)} times normal speed`);
    }, { signal: events.signal });
    motion.addEventListener('change', () => {
      // Changing the OS preference never silently starts motion.
      if (motion.matches) {
        running = false;
        stopFrame();
      }
      updateStatus();
    }, { signal: events.signal });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopFrame();
      else startFrame();
    }, { signal: events.signal });
    window.addEventListener('resize', resize, { signal: events.signal });
    const observer = new ResizeObserver(resize);
    observer.observe(canvas);
    seed = crypto.getRandomValues(seedBuffer)[0];
    resize();
    updateStatus();
    dispose = () => {
      destroyed = true;
      stopFrame();
      observer.disconnect();
      events.abort();
    };
  }

  // Works with ordinary navigation and Astro's optional client-side router.
  document.addEventListener('astro:page-load', mountFlowField);
  document.addEventListener('astro:before-swap', () => dispose?.());
  window.addEventListener('pagehide', () => dispose?.());
  window.addEventListener('pageshow', event => {
    if (event.persisted) mountFlowField();
  });
  mountFlowField();
</script>

<style>
  .back-link { display: inline-block; margin-bottom: 2rem; text-decoration: none; }
  .back-link:hover { color: var(--accent); }
  .experiment-intro { max-width: 44rem; font-size: 1.15rem; }
  .flow-experiment { margin-top: 2.5rem; }
  .canvas-frame { position: relative; border: 1px solid #293b59; border-radius: 1rem; overflow: hidden; background: #080f20; }
  canvas { display: block; width: 100%; height: clamp(320px, 52vw, 600px); }
  .canvas-label { position: absolute; left: 1rem; bottom: 1rem; color: #c9e9ff; font-family: monospace; font-size: .7rem; letter-spacing: .09em; text-transform: uppercase; pointer-events: none; background: #080f20d9; padding: .4rem .6rem; border-radius: .3rem; }
  .flow-controls { display: flex; align-items: end; flex-wrap: wrap; gap: 1.25rem 2rem; padding-top: 1.5rem; }
  .action-controls { display: flex; flex-wrap: wrap; gap: .75rem; }
  .flow-controls button { cursor: pointer; font: inherit; }
  .control-label { display: grid; gap: .55rem; font-size: .85rem; font-weight: 600; }
  .control-label select { font: inherit; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: .5rem; padding: .65rem .8rem; min-height: 44px; }
  .speed-control { min-width: 180px; flex: 1; max-width: 300px; }
  .speed-control span { display: flex; justify-content: space-between; gap: 1rem; }
  .speed-control output { color: var(--accent); font-variant-numeric: tabular-nums; }
  .speed-control input { width: 100%; min-height: 44px; margin: 0; accent-color: var(--accent); cursor: pointer; }
  .flow-controls :is(button, select, input):focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .flow-status { font-size: .85rem; min-height: 2.5em; margin-top: 1rem; }
  .experiment-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; margin-top: 3rem; }
  .experiment-notes h2 { font-size: 1.25rem; }
  @media (max-width: 650px) {
    .experiment-notes { grid-template-columns: 1fr; gap: 1rem; }
    .flow-controls { gap: 1.25rem; }
    .action-controls { width: 100%; }
    .speed-control { min-width: 140px; }
  }
</style>
