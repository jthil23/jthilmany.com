---
import Base from '../../layouts/Base.astro';
---
<Base title="Topo trail · Lab" description="Build a trail across generated terrain or real elevation data, then compare three pathfinding algorithms.">
  <section class="container section">
    <a class="back-link muted" href="/lab/">← Back to the lab</a>
    <p class="eyebrow">Lab / 001</p>
    <h1>Find your own <span>way.</span></h1>
    <p class="experiment-intro muted">A good trail doesn’t climb every slope head-on. Build one across a made-up mountain range or real elevation tiles, then compare how three search algorithms choose their way through the ground.</p>
    <div class="topo-experiment" data-topo-experiment>
      <div class="source-row">
        <label class="field-label">Terrain source
          <select data-source aria-label="Terrain source">
            <option value="generated">Generated terrain</option>
            <option value="real">Real places</option>
          </select>
        </label>
        <label class="field-label place-select" data-place-wrap hidden>Place
          <select data-place aria-label="Choose a real place"></select>
        </label>
        <div class="action-controls">
          <button class="button secondary" type="button" data-new-terrain>New terrain</button>
          <button class="button secondary" type="button" data-random-place hidden>Random spot</button>
        </div>
      </div>
      <div class="workspace">
        <div class="map-column">
          <div class="canvas-frame" data-canvas-frame>
            <canvas data-topo-canvas role="img" aria-label="Topographic map. Place trailhead A and destination B by clicking or tapping the map."></canvas>
            <div class="marker-layer" data-markers aria-label="Trail endpoints">
              <button class="endpoint endpoint-a" type="button" data-endpoint="start" aria-label="Trailhead A. Use arrow keys to move." hidden>A</button>
              <button class="endpoint endpoint-b" type="button" data-endpoint="goal" aria-label="Destination B. Use arrow keys to move." hidden>B</button>
            </div>
            <div class="map-label" data-map-label>Generated terrain</div>
            <div class="map-view" data-view3d hidden aria-label="Interactive three-dimensional terrain view"></div>
            <div class="view-fallback" data-view-error role="status" hidden></div>
            <div class="view-tools">
              <button class="button secondary" type="button" data-toggle-view aria-pressed="false">Open 3D view</button>
            </div>
          </div>
          <p class="map-detail muted" data-map-detail>Simulated elevations · generated at a local scale</p>
          <p class="attribution muted" data-attribution hidden>Elevation: Terrain Tiles on AWS Open Data (Mapzen; sources incl. USGS 3DEP, SRTM, GMTED, ETOPO1).</p>
          <details class="attribution-notes" data-attribution-notes hidden>
            <summary>Elevation data credits</summary>
            <p>Terrain tiles include data from multiple public sources. Required source credits include: ArcticDEM, created from DigitalGlobe imagery and funded under NSF awards 1043681, 1559691, and 1542736; Australia, © Commonwealth of Australia (Geoscience Australia) 2017; Austria, © offene Daten Österreichs – Digitales Geländemodell (DGM) Österreich; Canada, information licensed under the Open Government Licence – Canada; Europe, Copernicus-funded EU-DEM; global ETOPO1, NOAA; Mexico, INEGI, Continental relief, 2016; New Zealand, Copyright 2011 Crown copyright (c) Land Information New Zealand and the New Zealand Government; Norway, © Kartverket; United Kingdom, © Environment Agency copyright and/or database right 2015; United States 3DEP and global GMTED2010 and SRTM, courtesy of the U.S. Geological Survey.</p>
            <p>Source: <a href="https://github.com/tilezen/joerd/blob/master/docs/attribution.md" target="_blank" rel="noreferrer">Mapzen terrain attribution guidance</a>. Tiles are for terrain visualization, not navigation.</p>
          </details>
          <div class="route-legend" data-legend aria-label="Route color legend"></div>
        </div>
        <aside class="control-panel" aria-label="Trail planning controls">
          <div class="panel-block">
            <p class="eyebrow">01 / Route</p>
            <p class="control-copy">Click or tap once for trailhead A, then again for destination B. Drag either marker to adjust it; focus a marker and use arrow keys to nudge it.</p>
            <div class="action-controls">
              <button class="button secondary" type="button" data-random-endpoints>Random endpoints</button>
              <button class="button" type="button" data-run>Find trail</button>
            </div>
          </div>
          <label class="range-control"><span>Maximum grade <output data-grade-output>25%</output></span><input type="range" data-grade min="5" max="40" step="1" value="25" aria-label="Maximum allowed trail grade" /></label>
          <div class="panel-block">
            <p class="eyebrow">02 / Search strategy</p>
            <fieldset class="algorithm-choice">
              <legend class="sr-only">Pathfinding algorithm</legend>
              <label><input type="radio" name="algorithm" value="astar" checked /><span>A*</span></label>
              <label><input type="radio" name="algorithm" value="dijkstra" /><span>Dijkstra</span></label>
              <label><input type="radio" name="algorithm" value="greedy" /><span>Greedy</span></label>
            </fieldset>
            <button class="button secondary compare-button" type="button" data-compare aria-pressed="false">Compare all three</button>
          </div>
          <div class="panel-block results-block">
            <div class="results-heading"><p class="eyebrow">03 / Results</p><button class="text-button" type="button" data-replay>Replay search</button></div>
            <p class="results-status muted" data-topo-status role="status" aria-live="polite">Preparing terrain…</p>
            <div class="table-wrap" data-results-wrap hidden>
              <table class="results-table">
                <thead><tr><th scope="col">Method</th><th scope="col">Explored</th><th scope="col">Time (ms)</th><th scope="col">Length</th><th scope="col">Gain</th><th scope="col">Max grade</th></tr></thead>
                <tbody data-results></tbody>
              </table>
            </div>
          </div>
          <div class="action-controls bottom-actions">
            <button class="button secondary" type="button" data-download>Download PNG ↓</button>
            <label class="range-control compact" data-exaggeration-wrap hidden><span>Vertical exaggeration <output data-exaggeration-output>1.5×</output></span><input type="range" data-exaggeration min="0.7" max="3" step="0.1" value="1.5" aria-label="Vertical exaggeration" /></label>
          </div>
        </aside>
      </div>
      <noscript><p class="muted">JavaScript is needed to build terrain and search for routes. The notes below explain what each algorithm does.</p></noscript>
    </div>
    <div class="experiment-notes">
      <div><p class="eyebrow">01 / Terrain</p><h2>Ground with a little character.</h2><p class="muted">Generated terrain combines broad hills, ridged noise, domain warping, and erosion into a fictional height field; its elevations and 60 m cell scale are simulated. Real-place mode samples AWS Terrain Tiles in Terrarium format, so the colors and scale describe actual elevation data for the selected region.</p><p class="muted">Hypsometric color, hillshade, and index contours make the relief easier to read. Real tiles are cited below the map and in downloaded PNGs; they are terrain imagery, not hiking directions.</p></div>
      <div><p class="eyebrow">02 / Find a way</p><h2>Three ways through the hills.</h2><p class="muted"><strong>A*</strong> expands likely routes first, using a distance-and-climb estimate to guide its search. <strong>Dijkstra</strong> spreads outward by accumulated trail cost without a guess about the destination, while <strong>Greedy best-first</strong> follows the closest-looking direction and can trade optimality for fewer explored cells.</p><p class="muted">The grid connects each cell to its eight neighbors. A grade above your limit is blocked; otherwise horizontal distance, ascent, and steepness contribute to the cost. Compare runs each strategy on the same endpoints so you can inspect their routes, explored areas, and measurements side by side.</p></div>
    </div>
  </section>
</Base>
<script>
  import { generateTerrain, type HeightField } from '../../lib/topo/terrain';
  import { loadPlace, PLACES, randomPlace, TERRAIN_ATTRIBUTION, type TerrainPlace } from '../../lib/topo/tiles';
  import { createSearchClient, type SearchClient } from '../../lib/topo/searchClient';
  import { ALGORITHMS, ALGORITHM_LABELS, chooseConnectedEndpoints, type Algorithm, type SearchResult } from '../../lib/topo/pathfinding';
  import { renderMap, exportMap, ROUTE_COLORS, type MapState } from '../../lib/topo/render2d';
  import type { Terrain3DView } from '../../lib/topo/view3d';

  let disposeTopo: (() => void) | undefined;
  function mountTopo() {
    disposeTopo?.();
    disposeTopo = undefined;
    const root = document.querySelector<HTMLElement>('[data-topo-experiment]');
    if (!root) return;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-topo-canvas]');
    const frame = root.querySelector<HTMLElement>('[data-canvas-frame]');
    const status = root.querySelector<HTMLElement>('[data-topo-status]');
    const sourceSelect = root.querySelector<HTMLSelectElement>('[data-source]');
    const placeSelect = root.querySelector<HTMLSelectElement>('[data-place]');
    const placeWrap = root.querySelector<HTMLElement>('[data-place-wrap]');
    const randomPlaceButton = root.querySelector<HTMLButtonElement>('[data-random-place]');
    const terrainButton = root.querySelector<HTMLButtonElement>('[data-new-terrain]');
    const randomEndpoints = root.querySelector<HTMLButtonElement>('[data-random-endpoints]');
    const runButton = root.querySelector<HTMLButtonElement>('[data-run]');
    const compareButton = root.querySelector<HTMLButtonElement>('[data-compare]');
    const replayButton = root.querySelector<HTMLButtonElement>('[data-replay]');
    const downloadButton = root.querySelector<HTMLButtonElement>('[data-download]');
    const gradeInput = root.querySelector<HTMLInputElement>('[data-grade]');
    const gradeOutput = root.querySelector<HTMLOutputElement>('[data-grade-output]');
    const details = root.querySelector<HTMLElement>('[data-map-detail]');
    const mapLabel = root.querySelector<HTMLElement>('[data-map-label]');
    const attribution = root.querySelector<HTMLElement>('[data-attribution]');
    const attributionNotes = root.querySelector<HTMLDetailsElement>('[data-attribution-notes]');
    const resultsBody = root.querySelector<HTMLElement>('[data-results]');
    const resultsWrap = root.querySelector<HTMLElement>('[data-results-wrap]');
    const legend = root.querySelector<HTMLElement>('[data-legend]');
    const startMarker = root.querySelector<HTMLButtonElement>('[data-endpoint="start"]');
    const goalMarker = root.querySelector<HTMLButtonElement>('[data-endpoint="goal"]');
    const viewButton = root.querySelector<HTMLButtonElement>('[data-toggle-view]');
    const viewRoot = root.querySelector<HTMLElement>('[data-view3d]');
    const viewError = root.querySelector<HTMLElement>('[data-view-error]');
    const exaggerationWrap = root.querySelector<HTMLElement>('[data-exaggeration-wrap]');
    const exaggerationInput = root.querySelector<HTMLInputElement>('[data-exaggeration]');
    const exaggerationOutput = root.querySelector<HTMLOutputElement>('[data-exaggeration-output]');
    if (!canvas || !frame || !status || !sourceSelect || !placeSelect || !terrainButton || !randomEndpoints || !runButton || !compareButton || !replayButton || !downloadButton || !gradeInput || !gradeOutput || !resultsBody || !resultsWrap || !legend || !startMarker || !goalMarker || !viewButton || !viewRoot || !viewError || !exaggerationInput || !exaggerationOutput) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) { status.textContent = 'Canvas is unavailable. The experiment notes are still available below.'; return; }
    const events = new AbortController();
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let seed = crypto.getRandomValues(new Uint32Array(1))[0];
    let field: HeightField = generateTerrain({ seed });
    let searchClient: SearchClient | null = null;
    let start: number | null = null;
    let goal: number | null = null;
    let routes: SearchResult[] = [];
    let currentExplored: Partial<Record<Algorithm, Int32Array>> = {};
    let isCompare = false;
    let running = false;
    let loading = false;
    let view3d: Terrain3DView | null = null;
    let in3d = false;
    let renderFrame = 0;
    let searchFrame = 0;
    let pendingSearch = 0;
    let frontierAnimationCancel: (() => void) | null = null;
    let destroyed = false;
    let activeDrag: 'start' | 'goal' | null = null;
    let searchRevision = 0;
    let rerunRequested = false;
    let sourceNotice = '';
    for (const algorithm of ALGORITHMS) {
      const item = document.createElement('span');
      item.className = 'legend-item';
      item.innerHTML = `<i style="--route-color:${ROUTE_COLORS[algorithm]}"></i>${ALGORITHM_LABELS[algorithm]}`;
      legend.append(item);
    }
    let terrainController = new AbortController();

    for (const place of PLACES) {
      const option = document.createElement('option');
      option.value = place.id;
      option.textContent = place.name;
      placeSelect.append(option);
    }

    function makeState(): MapState {
      return { field, routes, explored: currentExplored, start, goal, label: field.name, detail: field.detail, attribution: TERRAIN_ATTRIBUTION };
    }
    function scheduleRender() {
      if (renderFrame) return;
      renderFrame = requestAnimationFrame(() => {
        renderFrame = 0;
        if (destroyed) return;
        if (in3d) { view3d?.update(makeState(), Number(exaggerationInput!.value)); return; }
        renderMap(canvas!, makeState());
        positionMarkers();
      });
    }
    function cellFromPoint(clientX: number, clientY: number): number | null {
      const bounds = canvas!.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return null;
      const x = Math.round((clientX - bounds.left) / bounds.width * (field.w - 1));
      const y = Math.round((clientY - bounds.top) / bounds.height * (field.h - 1));
      if (x < 0 || y < 0 || x >= field.w || y >= field.h) return null;
      return y * field.w + x;
    }
    function setEndpoint(which: 'start' | 'goal', cell: number | null) {
      if (cell !== null && field.water?.[cell]) { status!.textContent = 'That point is in water. Choose a dry cell for the endpoint.'; return; }
      searchRevision++;
      if (which === 'start') start = cell; else goal = cell;
      currentExplored = {};
      updateResults([]);
      updateStatus('Endpoint moved. Search again to find a trail.');
      scheduleRender();
      if (start !== null && goal !== null && !loading) scheduleSearch();
    }
    function positionMarker(button: HTMLButtonElement, cell: number | null) {
      button.hidden = cell === null;
      if (cell === null) return;
      const x = cell % field.w;
      const y = Math.floor(cell / field.w);
      button.style.left = `${x / (field.w - 1) * 100}%`;
      button.style.top = `${y / (field.h - 1) * 100}%`;
    }
    function positionMarkers() {
      positionMarker(startMarker!, start);
      positionMarker(goalMarker!, goal);
    }
    function updateStatus(message: string) { status!.textContent = sourceNotice ? `${sourceNotice} ${message}` : message; }
    function updateMeta() {
      if (details) details.textContent = field.detail;
      if (mapLabel) mapLabel.textContent = field.name;
      const isReal = !field.simulated;
      if (attribution) attribution.hidden = !isReal;
      if (attributionNotes) attributionNotes.hidden = !isReal;
      sourceSelect!.value = isReal ? 'real' : 'generated';
      const activePlace = PLACES.find(place => place.name === field.name);
      placeWrap?.toggleAttribute('hidden', !isReal);
      randomPlaceButton?.toggleAttribute('hidden', !isReal);
      if (activePlace) placeSelect!.value = activePlace.id;
    }
    function formatDistance(meters: number): string { return meters >= 1000 ? `${(meters / 1000).toFixed(1)} km` : `${Math.round(meters)} m`; }
    function updateResults(results: SearchResult[]) {
      resultsBody!.replaceChildren();
      resultsWrap!.hidden = results.length === 0;
      for (const result of results) {
        const row = document.createElement('tr');
        const method = document.createElement('th');
        method.scope = 'row';
        method.textContent = ALGORITHM_LABELS[result.algorithm];
        method.style.setProperty('--route-color', ROUTE_COLORS[result.algorithm]);
        const values = result.path ? [String(result.nodes), result.milliseconds.toFixed(1), formatDistance(result.length), `${Math.round(result.gain)} m`, `${result.maxGrade.toFixed(1)}%`] : [String(result.nodes), result.milliseconds.toFixed(1), 'No route', '—', '—'];
        row.append(method);
        for (const value of values) { const cell = document.createElement('td'); cell.textContent = value; row.append(cell); }
        resultsBody!.append(row);
      }
    }
    function disposeSearch() { searchClient?.dispose(); searchClient = null; }
    function replaceField(next: HeightField) {
      searchRevision++;
      disposeSearch();
      field = next;
      searchClient = createSearchClient(field);
      routes = [];
      currentExplored = {};
      updateMeta();
      chooseRandomEndpoints(false);
      scheduleRender();
    }
    function chooseRandomEndpoints(search = true) {
      let maxGrade = Number(gradeInput!.value);
      let endpoints = chooseConnectedEndpoints(field, maxGrade, crypto.getRandomValues(new Uint32Array(1))[0]);
      if (!endpoints && !field.simulated && maxGrade < 40) {
        const relaxedGrade = 40;
        endpoints = chooseConnectedEndpoints(field, relaxedGrade, crypto.getRandomValues(new Uint32Array(1))[0]);
        if (endpoints) {
          maxGrade = relaxedGrade;
          gradeInput!.value = String(relaxedGrade);
          gradeOutput!.value = `${relaxedGrade}%`;
          gradeInput!.setAttribute('aria-valuetext', `${relaxedGrade} percent maximum grade`);
        }
      }
      searchRevision++;
      currentExplored = {};
      updateResults([]);
      if (!endpoints) {
        start = null;
        goal = null;
        updateStatus(`No dry endpoint pair is connected within ${maxGrade}% maximum grade. Raise the grade limit to find a route.`);
        scheduleRender();
        return;
      }
      start = endpoints.start;
      goal = endpoints.goal;
      scheduleRender();
      if (search) scheduleSearch();
    }
    function selectedAlgorithm(): Algorithm {
      const selected = root!.querySelector<HTMLInputElement>('input[name="algorithm"]:checked')?.value;
      return selected === 'dijkstra' || selected === 'greedy' ? selected : 'astar';
    }
    function scheduleSearch() {
      if (pendingSearch) clearTimeout(pendingSearch);
      pendingSearch = window.setTimeout(() => {
        pendingSearch = 0;
        if (running) { rerunRequested = true; return; }
        void runSearch(true);
      }, 90);
    }
    async function runSearch(replay: boolean) {
      if (running) { rerunRequested = true; return; }
      if (loading || start === null || goal === null || destroyed) return;
      running = true;
      const revision = searchRevision;
      const grade = Number(gradeInput!.value);
      const algorithms = isCompare ? ALGORITHMS : [selectedAlgorithm()];
      routes = [];
      currentExplored = {};
      resultsWrap!.hidden = true;
      updateStatus('Searching the terrain…');
      scheduleRender();
      try {
        const resultSet = await Promise.all(algorithms.map(algorithm => searchClient!.search(start!, goal!, grade, algorithm)));
        if (destroyed || revision !== searchRevision) { rerunRequested = true; return; }
        routes = resultSet;
        updateResults(resultSet);
        const failed = resultSet.filter(result => !result.path).length;
        if (failed) updateStatus(`No route found within ${grade}% maximum grade${resultSet.length > 1 ? ` for ${failed} of ${resultSet.length} algorithms` : ''}. Try raising the grade limit or choosing new endpoints.`);
        else updateStatus(resultSet.length > 1 ? `Compared ${resultSet.length} routes. Search frontier ${motion.matches ? 'shown without animation' : 'ready to replay'}.` : `${ALGORITHM_LABELS[resultSet[0].algorithm]} found a ${formatDistance(resultSet[0].length)} route with ${Math.round(resultSet[0].gain)} m of ascent.`);
        if (replay && !motion.matches) await animateFrontier(resultSet);
        scheduleRender();
      } catch (error) {
        if (revision !== searchRevision) rerunRequested = true;
        else if (!destroyed) updateStatus(`The search worker stopped unexpectedly${error instanceof Error && error.message ? `: ${error.message}` : ''}. Try running the search again.`);
      } finally {
        running = false;
        if (rerunRequested && !destroyed) { rerunRequested = false; scheduleSearch(); }
      }
    }
    function cancelFrontierAnimation() {
      cancelAnimationFrame(searchFrame);
      searchFrame = 0;
      const settle = frontierAnimationCancel;
      frontierAnimationCancel = null;
      settle?.();
    }
    async function animateFrontier(results: SearchResult[]) {
      if (motion.matches || destroyed) return;
      cancelFrontierAnimation();
      currentExplored = {};
      const lengths: Partial<Record<Algorithm, number>> = {};
      for (const result of results) lengths[result.algorithm] = result.explored.length;
      const longest = Math.max(0, ...Object.values(lengths));
      let tick = 0;
      await new Promise<void>(resolve => {
        let settled = false;
        const finish = () => {
          if (settled) return;
          settled = true;
          searchFrame = 0;
          frontierAnimationCancel = null;
          currentExplored = {};
          scheduleRender();
          resolve();
        };
        frontierAnimationCancel = finish;
        const step = () => {
          if (destroyed || motion.matches || document.hidden || tick >= longest) { finish(); return; }
          tick += Math.max(40, Math.ceil(longest / 80));
          for (const result of results) currentExplored[result.algorithm] = result.explored.slice(0, Math.min(tick, result.explored.length));
          scheduleRender();
          searchFrame = requestAnimationFrame(step);
        };
        searchFrame = requestAnimationFrame(step);
      });
    }
    async function loadRealPlace(place: TerrainPlace) {
      sourceNotice = '';
      terrainController.abort();
      const requestController = new AbortController();
      terrainController = requestController;
      loading = true;
      sourceSelect!.disabled = true;
      placeSelect!.disabled = true;
      randomPlaceButton?.toggleAttribute('disabled', true);
      updateStatus(`Loading elevation tiles for ${place.name}…`);
      let succeeded = false;
      try {
        const loaded = await loadPlace(place, requestController.signal);
        if (destroyed || terrainController !== requestController) return;
        seed = (seed + 1) >>> 0;
        replaceField(loaded);
        succeeded = true;
        sourceNotice = '';
        updateStatus(`${loaded.name} ready. Place or move endpoints to plan a route.`);
      } catch (error) {
        if (!destroyed && terrainController === requestController && !(error instanceof DOMException && error.name === 'AbortError')) {
          sourceSelect!.value = 'generated';
          const fallback = generateTerrain({ seed: crypto.getRandomValues(new Uint32Array(1))[0] });
          replaceField(fallback);
          sourceNotice = `Could not load real elevation tiles (${error instanceof Error ? error.message : 'network error'}).`;
          updateStatus('Generated terrain is ready instead.');
        }
      } finally {
        if (terrainController === requestController) {
          loading = false;
          sourceSelect!.disabled = false;
          placeSelect!.disabled = false;
          randomPlaceButton?.removeAttribute('disabled');
          if (succeeded && !destroyed && start !== null && goal !== null) scheduleSearch();
        }
      }
    }
    function downloadPng() {
      const exportCanvas = exportMap(makeState());
      exportCanvas.toBlob(blob => {
        if (!blob || destroyed) { updateStatus('The PNG could not be created.'); return; }
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `topo-trail-${field.simulated ? seed.toString(16) : field.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.png`;
        link.click();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        updateStatus('PNG downloaded with terrain, routes, scale, and required elevation credits.');
      }, 'image/png');
    }
    function moveEndpoint(which: 'start' | 'goal', dx: number, dy: number) {
      const current = which === 'start' ? start : goal;
      if (current === null) return;
      let x = current % field.w;
      let y = Math.floor(current / field.w);
      for (let steps = 0; steps < Math.max(field.w, field.h); steps++) {
        x += dx; y += dy;
        if (x < 0 || y < 0 || x >= field.w || y >= field.h) return;
        const cell = y * field.w + x;
        if (!field.water?.[cell]) { setEndpoint(which, cell); return; }
      }
    }

    sourceSelect.addEventListener('change', () => {
      if (sourceSelect!.value === 'generated') {
        terrainController.abort();
        sourceNotice = '';
        seed = crypto.getRandomValues(new Uint32Array(1))[0];
        replaceField(generateTerrain({ seed }));
        updateStatus('New simulated terrain generated.');
        void runSearch(true);
      } else void loadRealPlace(PLACES.find(place => place.id === placeSelect!.value) ?? PLACES[0]);
    }, { signal: events.signal });
    placeSelect.addEventListener('change', () => { const place = PLACES.find(item => item.id === placeSelect!.value); if (place) void loadRealPlace(place); }, { signal: events.signal });
    randomPlaceButton?.addEventListener('click', () => { const place = randomPlace(); placeSelect!.value = place.id; void loadRealPlace(place); }, { signal: events.signal });
    terrainButton.addEventListener('click', () => {
      terrainController.abort();
      sourceNotice = '';
      if (!field.simulated) { seed = crypto.getRandomValues(new Uint32Array(1))[0]; replaceField(generateTerrain({ seed })); sourceSelect!.value = 'generated'; updateStatus('New simulated terrain generated.'); void runSearch(true); return; }
      seed = crypto.getRandomValues(new Uint32Array(1))[0]; replaceField(generateTerrain({ seed })); updateStatus('New simulated terrain generated.'); void runSearch(true);
    }, { signal: events.signal });
    randomEndpoints.addEventListener('click', () => chooseRandomEndpoints(true), { signal: events.signal });
    runButton.addEventListener('click', () => void runSearch(true), { signal: events.signal });
    compareButton.addEventListener('click', () => {
      isCompare = !isCompare;
      compareButton!.setAttribute('aria-pressed', String(isCompare));
      compareButton!.textContent = isCompare ? 'Compare mode on' : 'Compare all three';
      if (start !== null && goal !== null) {
        if (running) rerunRequested = true;
        else void runSearch(true);
      }
    }, { signal: events.signal });
    replayButton.addEventListener('click', () => { if (routes.length) void animateFrontier(routes); else void runSearch(true); }, { signal: events.signal });
    gradeInput.addEventListener('input', () => {
      gradeOutput!.value = `${gradeInput!.value}%`;
      gradeInput!.setAttribute('aria-valuetext', `${gradeInput!.value} percent maximum grade`);
      scheduleSearch();
    }, { signal: events.signal });
    root.querySelectorAll<HTMLInputElement>('input[name="algorithm"]').forEach(input => input.addEventListener('change', () => { if (!isCompare) scheduleSearch(); }, { signal: events.signal }));
    downloadButton.addEventListener('click', downloadPng, { signal: events.signal });
    canvas.addEventListener('click', event => {
      if (in3d) return;
      const cell = cellFromPoint(event.clientX, event.clientY);
      if (cell === null) return;
      if (start !== null && goal !== null) { goal = null; setEndpoint('start', cell); return; }
      if (start === null) setEndpoint('start', cell);
      else setEndpoint('goal', cell);
    }, { signal: events.signal });
    for (const marker of [startMarker, goalMarker]) {
      marker.addEventListener('pointerdown', event => {
        if (event.button !== 0) return;
        activeDrag = marker.dataset.endpoint === 'start' ? 'start' : 'goal';
        marker.setPointerCapture(event.pointerId);
        event.preventDefault();
      }, { signal: events.signal });
      marker.addEventListener('pointermove', event => {
        if (!activeDrag || !marker.hasPointerCapture(event.pointerId)) return;
        const cell = cellFromPoint(event.clientX, event.clientY);
        if (cell !== null && !field.water?.[cell]) {
          if (activeDrag === 'start') start = cell; else goal = cell;
          scheduleRender();
        }
      }, { signal: events.signal });
      marker.addEventListener('pointerup', event => {
        if (!activeDrag) return;
        activeDrag = null;
        marker.releasePointerCapture(event.pointerId);
        searchRevision++;
        routes = [];
        currentExplored = {};
        updateResults([]);
        updateStatus('Endpoint moved. Searching…');
        scheduleRender();
        if (start !== null && goal !== null) scheduleSearch();
      }, { signal: events.signal });
      marker.addEventListener('keydown', event => {
        const shifts: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
        const shift = shifts[event.key];
        if (!shift) return;
        event.preventDefault();
        const step = event.shiftKey ? 8 : 1;
        const which = marker.dataset.endpoint === 'start' ? 'start' : 'goal';
        moveEndpoint(which, shift[0] * step, shift[1] * step);
      }, { signal: events.signal });
    }
    viewButton.addEventListener('click', async () => {
      if (in3d) {
        view3d?.dispose(); view3d = null; in3d = false;
        viewRoot!.hidden = true; canvas!.hidden = false; startMarker!.hidden = start === null; goalMarker!.hidden = goal === null;
        exaggerationWrap?.toggleAttribute('hidden', true);
        viewButton!.textContent = 'Open 3D view'; viewButton!.setAttribute('aria-pressed', 'false');
        viewError!.hidden = true;
        scheduleRender();
        return;
      }
      viewError!.hidden = true;
      viewRoot!.hidden = false;
      viewRoot!.textContent = 'Preparing 3D terrain…';
      canvas!.hidden = true; startMarker!.hidden = true; goalMarker!.hidden = true;
      viewButton!.disabled = true;
      in3d = true;
      try {
        // Keep the Three.js scene and renderer out of the 2D page until 3D is explicitly opened.
        const { mount3D } = await import('../../lib/topo/view3d');
        if (destroyed) return;
        view3d = await mount3D(viewRoot!, makeState(), Number(exaggerationInput!.value), motion.matches);
        in3d = true;
        exaggerationWrap?.removeAttribute('hidden');
        viewButton!.textContent = 'Close 3D view'; viewButton!.setAttribute('aria-pressed', 'true');
      } catch {
        in3d = false;
        viewRoot!.hidden = true; canvas!.hidden = false; positionMarkers();
        viewError!.hidden = false;
        viewError!.textContent = 'A 3D view is not available in this browser. The 2D map and route planner are still ready.';
      } finally { viewButton!.disabled = false; }
    }, { signal: events.signal });
    exaggerationInput.addEventListener('input', () => {
      exaggerationOutput!.value = `${Number(exaggerationInput!.value).toFixed(1)}×`;
      if (view3d) view3d.update(makeState(), Number(exaggerationInput!.value));
    }, { signal: events.signal });
    const resizeObserver = new ResizeObserver(() => scheduleRender());
    resizeObserver.observe(canvas);
    const themeObserver = new MutationObserver(() => { scheduleRender(); });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    motion.addEventListener('change', () => {
      if (motion.matches) { cancelFrontierAnimation(); currentExplored = {}; scheduleRender(); }
    }, { signal: events.signal });
    document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelFrontierAnimation(); currentExplored = {}; scheduleRender(); } }, { signal: events.signal });
    updateMeta();
    searchClient = createSearchClient(field);
    chooseRandomEndpoints(false);
    positionMarkers();
    scheduleRender();
    status.textContent = 'Simulated terrain ready. Place endpoints or use the random pair, then find a trail.';
    void runSearch(true);
    disposeTopo = () => {
      destroyed = true;
      cancelAnimationFrame(renderFrame);
      cancelFrontierAnimation();
      if (pendingSearch) clearTimeout(pendingSearch);
      terrainController.abort();
      resizeObserver.disconnect();
      themeObserver.disconnect();
      disposeSearch();
      view3d?.dispose(); view3d = null;
      events.abort();
    };
  }
  mountTopo();
  document.addEventListener('astro:page-load', mountTopo);
  document.addEventListener('astro:before-swap', () => disposeTopo?.());
  window.addEventListener('pagehide', () => disposeTopo?.());
  window.addEventListener('pageshow', event => { if (event.persisted) mountTopo(); });
</script>
