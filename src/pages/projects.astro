---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import CommandIllustration from '../components/projects/CommandIllustration.astro';
import ScraperIllustration from '../components/projects/ScraperIllustration.astro';
import RaceIllustration from '../components/projects/RaceIllustration.astro';
const stacks: Record<string, string[]> = {
  'Command Center': ['Next.js 15', 'React 19', 'Tailwind', 'shadcn/ui', 'Tremor', 'Prisma', 'MariaDB', 'dockerode', 'WebSockets', 'node-cron', 'ssh2'],
  'Main Scraper': ['TypeScript', 'Cron scheduler', 'Web dashboard', 'MariaDB'],
  'F1 Dashboard': ['Next.js', 'Prisma', 'Docker', 'GitHub Actions'],
};
const captions = ['Infrastructure, brought into focus.', 'Useful data. Less manual work.', 'A different kind of dashboard.'];
---
<Base title="Projects" description="Explore Jeff Thilmany’s source projects: a home-server command center, scheduled data collection, and a Formula 1 dashboard.">
  <header class="container section project-intro">
    <p class="eyebrow">Personal projects / Open source</p>
    <h1>Ideas don’t belong<br />on a <span>to-do list.</span></h1>
    <div class="intro-bottom"><p class="lead">They belong in the world. A single pane of glass for the homelab, a pipeline for useful data, and a little obsession with Formula 1.</p><a class="text-link" href="#repositories">Explore the source ↓</a></div>
  </header>

  <section id="repositories" class="project-features" aria-label="Source repositories">
    {projects.map((project, index) => (
      <article class:list={['project-feature', { 'feature-reversed': index % 2 === 1 }]}>
        <div class="container feature-layout">
          <div class="feature-copy">
            <p class="feature-index"><span>{String(index + 1).padStart(2, '0')}</span> / {captions[index]}</p>
            <h2>{project.title}</h2>
            <p class="project-description">{project.description}</p>
            <ul class="stack-pills" aria-label={`${project.title} technology stack`}>{(stacks[project.title] ?? project.tags).map(tag => <li>{tag}</li>)}</ul>
            {project.href && <a class="button secondary" href={project.href}>Explore on GitHub <span aria-hidden="true">↗</span></a>}
            {index === 0 && <p class="source-note">A single pane of glass for SOL. Published as <code>jthil/command-center</code> on Docker Hub through GitHub Actions.</p>}
            {index === 1 && <p class="source-note">Scheduled collection across eleven scraper modules, with MariaDB behind the dashboard.</p>}
            {index === 2 && <p class="source-note">From race weekends to head-to-head comparisons. Docker publishing is handled through GitHub Actions.</p>}
          </div>
          <div class="feature-art">
            {index === 0 && <CommandIllustration />}
            {index === 1 && <ScraperIllustration />}
            {index === 2 && <RaceIllustration />}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="source-band">
    <div class="container source-layout">
      <div><p class="eyebrow">The work is in the code</p><h2>Not just a pretty interface.</h2><p>These are personal source repositories, not workplace case studies or links to deployed services. The visuals above are illustrations—not screenshots or live data.</p></div>
      <div class="source-actions"><a class="button" href="https://github.com/jthil23" rel="me">More on GitHub ↗</a><a class="text-link" href="/lab/">Or get hands-on in the lab →</a></div>
    </div>
  </section>
</Base>
<style>
  .project-intro { padding-bottom: 60px; }
  .project-intro h1 { max-width: 950px; }
  .intro-bottom { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .intro-bottom .lead { max-width: 650px; margin-bottom: 0; }
  .intro-bottom > a { flex: 0 0 auto; padding-bottom: 5px; }
  .project-feature { border-top: 1px solid var(--line); padding: 90px 0; overflow: clip; }
  .project-feature:nth-child(2) { background: var(--ice); }
  .feature-layout { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.15fr); gap: clamp(32px, 6vw, 85px); align-items: center; }
  .feature-reversed .feature-layout { grid-template-columns: minmax(0, 1.15fr) minmax(0, .95fr); }
  .feature-reversed .feature-copy { order: 2; }
  .feature-index { display: flex; align-items: center; gap: 13px; color: var(--muted); font: 10px/1.6 var(--font-mono); text-transform: uppercase; letter-spacing: .09em; }
  .feature-index span { color: var(--accent); font-size: 25px; letter-spacing: -.05em; }
  .feature-copy h2 { font-size: clamp(2.1rem, 4vw, 3.5rem); letter-spacing: -.055em; line-height: 1.08; margin: 24px 0; }
  .project-description { color: var(--muted); font-size: 1rem; line-height: 1.85; }
  .stack-pills { display: flex; flex-wrap: wrap; gap: 7px; list-style: none; padding: 0; margin: 26px 0 30px; }
  .stack-pills li { border: 1px solid var(--line); border-radius: 5px; padding: 4px 8px; color: var(--muted); font: 10px/1.5 var(--font-mono); }
  .source-note { color: var(--muted); font-size: 11px; max-width: 350px; margin-top: 20px; }
  .source-note code { color: var(--accent); overflow-wrap: anywhere; }
  .feature-art { min-width: 0; }
  .source-band { border-block: 1px solid var(--line); background: var(--soft); padding: 66px 0; }
  .source-layout { display: flex; justify-content: space-between; align-items: center; gap: 40px; }
  .source-layout h2 { font-size: clamp(1.75rem, 3vw, 2.7rem); margin: 12px 0; letter-spacing: -.04em; }
  .source-layout p:not(.eyebrow) { color: var(--muted); max-width: 620px; font-size: .95rem; }
  .source-actions { display: grid; gap: 20px; flex: 0 0 auto; }
  @media (max-width: 900px) { .feature-layout, .feature-reversed .feature-layout { grid-template-columns: 1fr; gap: 40px; } .feature-reversed .feature-copy { order: 0; } .feature-art { width: min(100%, 650px); margin-inline: auto; } .project-feature { padding: 60px 0; } .source-layout { flex-direction: column; align-items: start; } .intro-bottom { flex-direction: column; align-items: start; } }
  @media (max-width: 600px) { .project-intro { padding-bottom: 38px; } .project-feature { padding: 42px 0; } .feature-index { font-size: 9px; gap: 10px; } .feature-copy h2 { margin: 18px 0; } .source-band { padding: 42px 0; } }
</style>
