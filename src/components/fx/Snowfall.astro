---
interface Props { flurry?: boolean }
const { flurry = false } = Astro.props;
---
<canvas class:list={['snowfall', { 'snowfall-flurry': flurry }]} data-snowfall={flurry ? 'flurry' : 'hero'} aria-hidden="true"></canvas>

<style>
  .snowfall { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; color: var(--ice-bright); }
  .snowfall-flurry { position: fixed; z-index: 35; }
  :global(:root[data-theme='light']) .snowfall { color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .snowfall { display: none; } }
</style>

<script>
  interface Crystal { x: number; y: number; radius: number; speed: number; drift: number; phase: number; opacity: number; }
  interface SnowLayer {
    canvas: HTMLCanvasElement;
    context: CanvasRenderingContext2D;
    flurry: boolean;
    visible: boolean;
    width: number;
    height: number;
    age: number;
    remaining: number;
    color: string;
    crystals: Crystal[];
  }

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const layers: SnowLayer[] = [];
  let frame = 0;
  let previous = 0;
  let elapsed = 0;

  const randomize = (crystal: Crystal, layer: SnowLayer, initial: boolean) => {
    crystal.x = Math.random() * layer.width;
    crystal.y = initial ? Math.random() * layer.height : -8;
    crystal.radius = .7 + Math.random() * 1.5;
    crystal.speed = layer.flurry ? 65 + Math.random() * 100 : 12 + Math.random() * 22;
    crystal.drift = 5 + Math.random() * 13;
    crystal.phase = Math.random() * Math.PI * 2;
    crystal.opacity = .18 + Math.random() * .34;
  };

  const resize = (layer: SnowLayer) => {
    const bounds = layer.canvas.getBoundingClientRect();
    layer.width = bounds.width;
    layer.height = bounds.height;
    const scale = Math.min(window.devicePixelRatio || 1, 1.5);
    layer.canvas.width = Math.round(layer.width * scale);
    layer.canvas.height = Math.round(layer.height * scale);
    layer.context.setTransform(scale, 0, 0, scale, 0, 0);
    layer.color = getComputedStyle(layer.canvas).color;
    const count = Math.min(layer.flurry ? 110 : 38, Math.round(layer.width / (layer.flurry ? 10 : 30)) + 10);
    layer.crystals = Array.from({ length: count }, () => {
      const crystal: Crystal = { x: 0, y: 0, radius: 0, speed: 0, drift: 0, phase: 0, opacity: 0 };
      randomize(crystal, layer, true);
      return crystal;
    });
  };

  const active = (layer: SnowLayer) => layer.visible && (!layer.flurry || layer.remaining > 0);
  const canAnimate = () => !reducedMotion.matches && !document.hidden && layers.some(active);
  const schedule = () => {
    if (!frame && canAnimate()) {
      previous = performance.now();
      elapsed = 0;
      frame = requestAnimationFrame(paint);
    }
  };
  const pause = () => { cancelAnimationFrame(frame); frame = 0; };

  function paint(now: number) {
    frame = 0;
    if (!canAnimate()) return;
    elapsed += Math.min((now - previous) / 1000, .05);
    previous = now;
    // Cap drawing at 30 fps; positions use elapsed time rather than frame count.
    if (elapsed >= 1 / 30) {
      const delta = elapsed;
      elapsed = 0;
      for (const layer of layers) {
        if (!active(layer)) continue;
        const { context, width, height } = layer;
        context.clearRect(0, 0, width, height);
        layer.age += delta;
        if (layer.flurry) {
          layer.remaining = Math.max(0, layer.remaining - delta);
          if (!layer.remaining) continue;
        }
        context.fillStyle = layer.color;
        context.strokeStyle = layer.color;
        const fade = layer.flurry ? Math.min(1, layer.age * 2, layer.remaining) : 1;
        for (const crystal of layer.crystals) {
          crystal.y += crystal.speed * delta;
          crystal.x += (Math.sin(layer.age * .6 + crystal.phase) * crystal.drift + 5) * delta;
          if (crystal.y > height + 8) randomize(crystal, layer, false);
          if (crystal.x > width + 8) crystal.x = -8;
          if (crystal.x < -8) crystal.x = width + 8;
          context.globalAlpha = crystal.opacity * fade;
          if (crystal.radius > 1.6) {
            const r = crystal.radius * 1.7;
            context.lineWidth = .7;
            context.beginPath();
            context.moveTo(crystal.x - r, crystal.y);
            context.lineTo(crystal.x + r, crystal.y);
            context.moveTo(crystal.x, crystal.y - r);
            context.lineTo(crystal.x, crystal.y + r);
            context.stroke();
          } else {
            context.beginPath();
            context.arc(crystal.x, crystal.y, crystal.radius, 0, Math.PI * 2);
            context.fill();
          }
        }
      }
    }
    if (canAnimate()) frame = requestAnimationFrame(paint);
  }

  const visibility = new IntersectionObserver(entries => {
    for (const entry of entries) {
      const layer = layers.find(candidate => candidate.canvas === entry.target);
      if (layer) layer.visible = entry.isIntersecting;
    }
    if (canAnimate()) schedule(); else pause();
  });
  const dimensions = new ResizeObserver(entries => {
    for (const entry of entries) {
      const layer = layers.find(candidate => candidate.canvas === entry.target);
      if (layer) resize(layer);
    }
    schedule();
  });
  document.querySelectorAll<HTMLCanvasElement>('[data-snowfall]').forEach(canvas => {
    const context = canvas.getContext('2d');
    if (!context) return;
    const layer: SnowLayer = { canvas, context, flurry: canvas.dataset.snowfall === 'flurry', visible: false, width: 0, height: 0, age: 0, remaining: 0, color: '', crystals: [] };
    layers.push(layer);
    resize(layer);
    visibility.observe(canvas);
    dimensions.observe(canvas);
  });

  // Public, document-wide easter egg: dispatch a CustomEvent('jt:snow').
  window.addEventListener('jt:snow', () => {
    if (reducedMotion.matches) return;
    for (const layer of layers) {
      if (!layer.flurry) continue;
      layer.age = 0;
      layer.remaining = 4;
      for (const crystal of layer.crystals) randomize(crystal, layer, true);
    }
    schedule();
  });
  document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); else schedule(); });
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) {
      pause();
      for (const layer of layers) {
        layer.remaining = 0;
        layer.context.clearRect(0, 0, layer.width, layer.height);
      }
    } else schedule();
  });
  const theme = new MutationObserver(() => {
    for (const layer of layers) layer.color = getComputedStyle(layer.canvas).color;
  });
  theme.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  window.addEventListener('pagehide', pause);
  window.addEventListener('pageshow', schedule);
</script>
