---
import { server } from '../../data/services';
const specs = [
  ['Operating system', server.os],
  ['Processor', server.cpu],
  ['Compute', server.cores],
  ['Memory', server.memory],
  ['Graphics', server.gpu],
  ['Storage', server.storage],
  ['Containers', server.containers],
];
---
<section class="identity" aria-labelledby="sol-title">
  <div class="identity-copy">
    <p class="eyebrow">Homelab / self-hosted / built at home</p>
    <h1 id="sol-title">Meet <span>{server.name}.</span></h1>
    <p class="intro">One server.<br />A whole little universe.</p>
    <p class="identity-description">Media, smart-home automations, local AI, and the tools that tie it all together. My playground for building systems that actually do something.</p>
    <a class="text-link" href="#constellation">Explore the constellation <span aria-hidden="true">↓</span></a>
  </div>
  <div class="server-stage">
    <div class="stage-heading"><span>Hardware portrait</span><span>01 / SOL</span></div>
    <svg class="rack" viewBox="0 0 460 440" role="img" aria-labelledby="rack-title rack-desc">
      <title id="rack-title">Illustrated portrait of SOL</title>
      <desc id="rack-desc">An abstract rack server with drive bays, cooling fans, and blue indicator lights. This is an illustration, not a live hardware display.</desc>
      <defs>
        <pattern id="rack-grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" class="grid-stroke" /></pattern>
      </defs>
      <rect width="460" height="440" fill="url(#rack-grid)" />
      <ellipse cx="236" cy="369" rx="158" ry="29" class="rack-shadow" />
      <path d="M92 87 140 56h257l-47 31Z" class="rack-top" />
      <path d="M350 87 397 56v262l-47 35Z" class="rack-side" />
      <rect x="92" y="87" width="258" height="266" rx="9" class="rack-front" />
      <path d="M109 107h224M109 330h224" class="rack-divider" />
      <text x="113" y="132" class="rack-brand">S O L</text>
      <text x="277" y="132" class="rack-small">UNRAID</text>
      {[0, 1, 2].map(row => <g>
        <rect x="111" y={150 + row * 49} width="220" height="39" rx="4" class="drive" />
        {[0, 1, 2, 3].map(column => <g>
          <rect x={119 + column * 49} y={158 + row * 49} width="39" height="23" rx="2" class="drive-slot" />
          <path d={`M${125 + column * 49} ${165 + row * 49}h24m-24 5h24m-24 5h24`} class="vent" />
        </g>)}
        <circle cx="320" cy={169 + row * 49} r="3" class={`led led-${row}`} />
      </g>)}
      {[0, 1, 2].map(fan => <g>
        <circle cx={152 + fan * 69} cy="306" r="21" class="fan-ring" />
        <circle cx={152 + fan * 69} cy="306" r="15" class="fan-inner" />
        <path d={`M${152 + fan * 69} 291v30m-15-15h30m-26-11 22 22m-22 0 22-22`} class="vent" />
        <circle cx={152 + fan * 69} cy="306" r="4" class="fan-center" />
      </g>)}
      <path d="M62 179h29M350 237h49M235 353v38" class="callout-line" />
      <text x="18" y="174" class="rack-small">ARRAY</text>
      <text x="363" y="230" class="rack-small">GPU</text>
      <text x="209" y="412" class="rack-small">LOCAL FIRST</text>
    </svg>
    <p class="illustration-note">Hardware illustration · not a live status display</p>
  </div>
  <dl class="specs">{specs.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
</section>
<style>
  .identity { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 28px 56px; padding-block: 64px 36px; }
  .identity h1 { font-size: clamp(4.5rem, 10vw, 8.5rem); line-height: .95; letter-spacing: -.075em; margin: 24px 0; }
  .identity h1 span { color: var(--accent); }
  .intro { font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.2; letter-spacing: -.04em; margin: 0 0 20px; }
  .identity-description { color: var(--muted); max-width: 45ch; margin-bottom: 26px; }
  .server-stage { border: 1px solid var(--line); border-radius: 24px; background: radial-gradient(ellipse at center, var(--soft), var(--panel) 75%); overflow: hidden; }
  .stage-heading { display: flex; justify-content: space-between; gap: 16px; padding: 20px 24px 0; font: .65rem var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .rack { width: 100%; display: block; }
  .grid-stroke { stroke: var(--line); opacity: .35; }
  .rack-shadow { fill: var(--ambient); }
  .rack-front { fill: var(--panel); stroke: var(--accent); stroke-width: 1.5; }
  .rack-top, .drive { fill: var(--soft); stroke: var(--line); }
  .rack-side { fill: var(--bg); stroke: var(--accent); stroke-opacity: .5; }
  .rack-divider, .vent { fill: none; stroke: var(--line); }
  .drive-slot { fill: var(--bg); stroke: var(--line); }
  .rack-brand { fill: var(--text); font: 700 17px var(--font-mono); }
  .rack-small { fill: var(--muted); font: 8px var(--font-mono); letter-spacing: 1px; }
  .led, .fan-center { fill: var(--accent); }
  .led { animation: led-glow 4s ease-in-out infinite; }
  .led-1 { animation-delay: 1s; }
  .led-2 { animation-delay: 2s; }
  .fan-ring { fill: var(--bg); stroke: var(--line); }
  .fan-inner { fill: none; stroke: var(--accent); stroke-opacity: .4; }
  .callout-line { stroke: var(--accent); fill: none; stroke-dasharray: 3 3; }
  .illustration-note { text-align: center; font: .65rem var(--font-mono); color: var(--muted); padding: 0 12px 12px; margin-top: 0; }
  .specs { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(7, 1fr); margin: 0; padding-block: 28px; border-block: 1px solid var(--line); gap: 16px; }
  .specs dt { font: .65rem var(--font-mono); text-transform: uppercase; color: var(--muted); margin-bottom: 8px; letter-spacing: .03em; }
  .specs dd { margin: 0; font-size: .92rem; font-weight: 650; }
  @keyframes led-glow { 50% { opacity: .3; } }
  @media (max-width: 1050px) { .specs { grid-template-columns: repeat(4, 1fr); gap: 24px; } .identity { gap: 28px; } }
  @media (max-width: 680px) { .identity { grid-template-columns: 1fr; padding-top: 40px; } .identity h1 { font-size: 5.5rem; } .server-stage { max-width: 460px; width: 100%; } .specs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .led { animation: none; } }
</style>
