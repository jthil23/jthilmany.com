---
import { serviceBySlug } from '../../data/services';
interface Props { id: string; title: string; kicker: string; caption: string; steps: { slug: string; step: string }[]; }
const { id, title, kicker, caption, steps } = Astro.props;
---
<section class="pipeline" aria-labelledby={`${id}-title`}>
  <div class="pipeline-heading"><p class="eyebrow">{kicker}</p><h3 id={`${id}-title`}>{title}</h3></div>
  <ol class="pipeline-track" style={`--start:calc(50% / ${steps.length});`} aria-label={`${title}, illustrated flow`}>
    {steps.map((step, index) => {
      const service = serviceBySlug(step.slug);
      return <li>
        <div class="pipeline-logo"><img src={`/icons/services/${service.icon}`} width="36" height="36" alt={`${service.name} logo`} loading="lazy" /></div>
        <div class="step-copy"><span class="step-index">{String(index + 1).padStart(2, '0')}</span><strong>{step.step}</strong><span class="step-service">{service.name}</span></div>
      </li>;
    })}
  </ol>
  <p class="pipeline-caption">{caption}</p>
</section>
<style>
  .pipeline { padding: 32px; border: 1px solid var(--line); border-radius: 24px; background: var(--panel); }
  .pipeline + .pipeline { margin-top: 20px; }
  .pipeline-heading h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); letter-spacing: -.04em; line-height: 1.1; margin: 0; }
  .pipeline-track { position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); padding: 0; margin: 36px 0 24px; list-style: none; isolation: isolate; }
  .pipeline-track::before { content: ''; position: absolute; top: 32px; left: var(--start); right: var(--start); height: 1px; background: var(--line); z-index: -1; }
  .pipeline-track::after { content: ''; position: absolute; top: 31px; left: var(--start); width: 30px; height: 3px; border-radius: 4px; background: var(--accent); box-shadow: 0 0 14px var(--accent); z-index: -1; animation: travel 7s linear infinite; }
  .pipeline-track li { display: grid; justify-items: center; text-align: center; min-width: 0; gap: 16px; }
  .pipeline-logo { display: grid; place-items: center; width: 64px; height: 64px; background: var(--soft); border: 1px solid var(--line); border-radius: 18px; }
  .pipeline-logo img { object-fit: contain; }
  .step-copy { display: grid; gap: 3px; }
  .step-index { color: var(--accent); font: .6rem var(--font-mono); }
  .step-copy strong { font-size: .83rem; font-weight: 650; }
  .step-service { font-size: .65rem; color: var(--muted); }
  .pipeline-caption { color: var(--muted); font-size: .86rem; max-width: 80ch; margin: 0; }
  @keyframes travel { from { left: var(--start); opacity: 0; } 10%, 90% { opacity: 1; } to { left: calc(100% - var(--start) - 30px); opacity: 0; } }
  @keyframes travel-down { from { top: 24px; opacity: 0; } 10%, 90% { opacity: 1; } to { top: calc(100% - 48px); opacity: 0; } }
  @media (max-width: 700px) {
    .pipeline { padding: 24px; }
    .pipeline-track { grid-auto-flow: row; grid-auto-columns: auto; gap: 24px; margin-block: 28px; }
    .pipeline-track li { grid-template-columns: 56px minmax(0, 1fr); align-items: center; justify-items: start; text-align: left; gap: 18px; }
    .pipeline-logo { width: 56px; height: 56px; border-radius: 15px; }
    .step-copy { grid-template-columns: auto 1fr; gap: 2px 10px; align-items: center; }
    .step-service { grid-column: 2; }
    .pipeline-track::before { top: 24px; bottom: 24px; left: 27px; right: auto; height: auto; width: 1px; }
    .pipeline-track::after { left: 26px; top: 24px; width: 3px; height: 24px; animation-name: travel-down; }
  }
  @media (prefers-reduced-motion: reduce) { .pipeline-track::after { display: none; animation: none; } }
</style>
