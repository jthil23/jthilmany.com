---
import { projects } from '../data/projects';
import { services } from '../data/services';
import { site } from '../data/site';
const pages = [
  ['Home', '/', 'Start here · Build, solve, explore, repeat'],
  ['Work', '/work', 'Business solutions · Power Platform · .NET'],
  ['Projects', '/projects', 'Public source code and personal projects'],
  ['Lab', '/lab', 'Interactive experiments'],
  ['Topo trail', '/lab/topo-trail', 'Trail pathfinding on real and generated terrain'],
  ['Racing line', '/lab/racing-line', 'AI cars learn a Formula 1 circuit'],
  ['Request flow', '/lab/request-flow', 'How a request moves through the homelab'],
  ['Guide', '/guide', 'Build your own home server, step by step'],
  ['Radar', '/radar', 'Tech, AI, homelab, F1, and Microsoft headlines'],
  ['Notes', '/notes', 'Writing and field notes'],
  ['Homelab', '/homelab', 'SOL · Self-hosted services'],
];
const entries = [
  ...pages.map(([label, href, detail]) => ({ label, href, detail, kind: 'Page', icon: '', action: '' })),
  { label: 'Toggle theme', href: '', detail: 'Switch between deep navy and frost', kind: 'Action', icon: '', action: 'theme' },
  { label: 'Copy site URL', href: '', detail: `https://${site.domain}`, kind: 'Action', icon: '', action: 'copy' },
  ...projects.filter(project => project.href).map(project => ({ label: project.title, href: project.href!, detail: `GitHub · ${project.tags.join(' · ')}`, kind: 'Project', icon: '', action: '' })),
  ...services.map(service => ({ label: service.name, href: `/homelab#${service.slug}`, detail: `${service.category} · ${service.description}`, kind: 'Service', icon: `/icons/services/${service.icon}`, action: '' })),
];
---
<dialog id="command-palette" class="palette" aria-labelledby="palette-title" data-entries={JSON.stringify(entries)} data-site-url={`https://${site.domain}`}>
  <div class="palette-top">
    <div><p class="palette-eyebrow">Quick navigation</p><h2 id="palette-title">Where to?</h2></div>
    <button class="palette-close" type="button" aria-label="Close command palette">Esc</button>
  </div>
  <label class="sr-only" for="palette-search">Search pages, projects, services, and actions</label>
  <div class="palette-input-wrap">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="6.5" /><path d="m15 15 6 6" /></svg>
    <input id="palette-search" type="search" autocomplete="off" spellcheck="false" placeholder="Pages, projects, services…" role="combobox" aria-autocomplete="list" aria-controls="palette-results" aria-expanded="false" aria-describedby="palette-help" />
  </div>
  <div id="palette-results" class="palette-results" role="listbox" aria-label="Search results"></div>
  <p id="palette-status" class="palette-status" role="status" aria-live="polite"></p>
  <div class="palette-bottom" id="palette-help"><span><kbd>↑</kbd><kbd>↓</kbd> to explore · <kbd>Enter</kbd> to open</span><span class="palette-count"></span></div>
</dialog>
<script>
  type Entry = { label: string; href: string; detail: string; kind: string; icon: string; action: string };
  const dialog = document.querySelector<HTMLDialogElement>('#command-palette');
  const input = dialog?.querySelector<HTMLInputElement>('#palette-search');
  const results = dialog?.querySelector<HTMLDivElement>('#palette-results');
  const status = dialog?.querySelector<HTMLParagraphElement>('#palette-status');
  const trigger = document.querySelector<HTMLButtonElement>('#palette-trigger');
  if (dialog && input && results && status) {
    const entries: Entry[] = JSON.parse(dialog.dataset.entries ?? '[]');
    const count = dialog.querySelector<HTMLElement>('.palette-count');
    let filtered: Entry[] = [];
    let active = 0;
    let returnFocus: HTMLElement | null = null;
    function score(text: string, term: string): number {
      const lower = text.toLocaleLowerCase();
      if (lower === term) return 200;
      if (lower.startsWith(term)) return 120;
      if (lower.includes(term)) return 80;
      let cursor = 0;
      let gaps = 0;
      for (const character of term) {
        const next = lower.indexOf(character, cursor);
        if (next < 0) return 0;
        gaps += next - cursor;
        cursor = next + 1;
      }
      return Math.max(1, 40 - gaps);
    }
    function select(index: number) {
      active = index;
      const options = results!.querySelectorAll<HTMLButtonElement>('[role="option"]');
      options.forEach((option, position) => option.setAttribute('aria-selected', String(position === active)));
      const selected = options[active];
      if (selected) {
        input!.setAttribute('aria-activedescendant', selected.id);
        selected.scrollIntoView({ block: 'nearest' });
      } else input!.removeAttribute('aria-activedescendant');
    }
    function render() {
      const terms = input!.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
      filtered = entries.map(entry => {
        const scores = terms.map(term => score(entry.label, term) * 3 || score(`${entry.kind} ${entry.detail}`, term));
        return { entry, score: scores.every(value => value > 0) ? scores.reduce((sum, value) => sum + value, 0) : -1 };
      }).filter(item => item.score >= 0).sort((a, b) => b.score - a.score).map(item => item.entry);
      results!.replaceChildren();
      status!.textContent = filtered.length ? '' : 'No matching trail. Try a page, project, or service name.';
      if (count) count.textContent = `${filtered.length} results`;
      filtered.forEach((entry, index) => {
        const option = document.createElement('button');
        option.type = 'button';
        option.className = 'palette-option';
        option.id = `palette-option-${index}`;
        option.setAttribute('role', 'option');
        option.tabIndex = -1;
        if (entry.icon) {
          const icon = document.createElement('img');
          icon.src = entry.icon;
          icon.alt = '';
          icon.width = 30;
          icon.height = 30;
          option.append(icon);
        } else {
          const icon = document.createElement('span');
          icon.className = 'palette-symbol';
          icon.setAttribute('aria-hidden', 'true');
          icon.textContent = entry.kind === 'Action' ? '✦' : entry.kind === 'Project' ? '{ }' : '↗';
          option.append(icon);
        }
        const text = document.createElement('span');
        text.className = 'palette-option-text';
        const label = document.createElement('strong');
        label.textContent = entry.label;
        const detail = document.createElement('span');
        detail.textContent = entry.detail;
        text.append(label, detail);
        const kind = document.createElement('span');
        kind.className = 'palette-kind';
        kind.textContent = entry.kind;
        option.append(text, kind);
        option.addEventListener('click', () => {
          select(index);
          input!.focus();
          void execute(entry);
        });
        results!.append(option);
      });
      results!.scrollTop = 0;
      select(0);
    }
    async function execute(entry: Entry) {
      if (entry.action === 'theme') {
        document.querySelector<HTMLButtonElement>('#theme-toggle')?.click();
        status!.textContent = `Switched to ${document.documentElement.dataset.theme || 'dark'} theme.`;
      } else if (entry.action === 'copy') {
        const url = dialog!.dataset.siteUrl ?? window.location.origin;
        try {
          if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(url);
          status!.textContent = 'Site URL copied. Share the trail.';
        } catch { status!.textContent = `Clipboard unavailable. Site URL: ${url}`; }
      } else window.location.assign(entry.href);
    }
    function open() {
      if (dialog!.open) return;
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      input!.value = '';
      dialog!.showModal();
      document.documentElement.classList.add('palette-open');
      input!.setAttribute('aria-expanded', 'true');
      trigger?.setAttribute('aria-expanded', 'true');
      render();
      input!.focus();
    }
    trigger?.addEventListener('click', open);
    document.querySelectorAll<HTMLButtonElement>('[data-open-palette]').forEach(button => button.addEventListener('click', open));
    dialog.querySelector('.palette-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('palette-open');
      input.setAttribute('aria-expanded', 'false');
      trigger?.setAttribute('aria-expanded', 'false');
      returnFocus?.focus();
    });
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
    input.addEventListener('input', render);
    input.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (filtered.length) select((active + (event.key === 'ArrowDown' ? 1 : -1) + filtered.length) % filtered.length);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const entry = filtered[active];
        if (entry) void execute(entry);
      }
    });
    document.addEventListener('keydown', event => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k' && !event.altKey) {
        event.preventDefault();
        if (dialog.open) dialog.close(); else open();
      }
    });
    const shortcut = trigger?.querySelector('kbd');
    if (shortcut && !/Mac|iPhone|iPad/.test(navigator.platform)) shortcut.textContent = 'Ctrl K';
  }
</script>
<style>
  .palette { width: min(640px, calc(100% - 28px)); max-height: min(720px, calc(100dvh - 40px)); margin: auto; padding: 0; border: 1px solid var(--line); border-radius: 20px; background: var(--panel); color: var(--text); box-shadow: 0 28px 100px color-mix(in srgb, var(--bg) 65%, transparent); overflow: hidden; }
  .palette::backdrop { background: color-mix(in srgb, var(--bg) 75%, transparent); backdrop-filter: blur(9px); }
  .palette-top { display: flex; align-items: center; justify-content: space-between; padding: 22px 24px 16px; }
  .palette-eyebrow { margin: 0 0 4px; font: 10px var(--font-mono); text-transform: uppercase; letter-spacing: .14em; color: var(--accent); }
  .palette h2 { font-size: 1.7rem; margin: 0; }
  .palette-close { padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--soft); color: var(--muted); cursor: pointer; font: 12px var(--font-mono); }
  .palette-input-wrap { display: flex; align-items: center; gap: 12px; padding: 0 24px 18px; border-bottom: 1px solid var(--line); color: var(--accent); }
  .palette-input-wrap svg { flex-shrink: 0; }
  .palette input { width: 100%; min-width: 0; padding: 10px 3px; border: 0; border-radius: 4px; background: transparent; color: var(--text); font-size: 16px; }
  .palette input::placeholder { color: var(--muted); }
  .palette input:focus-visible { outline-offset: 2px; }
  .palette-results { max-height: min(400px, calc(100dvh - 260px)); min-height: 60px; overflow-y: auto; overscroll-behavior: contain; padding: 8px; }
  .palette :global(.palette-option) { width: 100%; display: flex; align-items: center; gap: 14px; padding: 13px 14px; text-align: left; border: 1px solid transparent; border-radius: 10px; background: transparent; color: var(--text); cursor: pointer; }
  .palette :global(.palette-option:hover), .palette :global(.palette-option[aria-selected="true"]) { background: var(--soft); border-color: var(--line); }
  .palette :global(.palette-option img), .palette :global(.palette-symbol) { flex: 0 0 30px; width: 30px; height: 30px; object-fit: contain; }
  .palette :global(.palette-symbol) { display: grid; place-items: center; color: var(--accent); font: 16px var(--font-mono); }
  .palette :global(.palette-option-text) { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .palette :global(.palette-option-text strong) { font-weight: 600; }
  .palette :global(.palette-option-text > span) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); font-size: 12px; }
  .palette :global(.palette-kind) { flex-shrink: 0; color: var(--muted); font: 10px var(--font-mono); text-transform: uppercase; }
  .palette-status { padding: 0 24px; margin: 0; color: var(--accent); font-size: 13px; overflow-wrap: anywhere; }
  .palette-status:not(:empty) { padding-block: 14px; }
  .palette-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding: 14px 24px; border-top: 1px solid var(--line); color: var(--muted); font: 10px var(--font-mono); }
  .palette-bottom kbd { margin-right: 4px; color: var(--text); font: inherit; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 420px) { .palette-top { padding-inline: 18px; } .palette-input-wrap { padding-inline: 18px; } .palette :global(.palette-option) { gap: 10px; padding-inline: 10px; } .palette :global(.palette-kind) { font-size: 9px; } }
</style>
