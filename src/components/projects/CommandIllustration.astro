---
import { services } from '../../data/services';
const pages = ['Dashboard', 'Containers', 'Media', 'Storage', 'Automations', 'System', 'Logs', 'Settings'];
const visibleServices = services.filter(service => ['plex', 'sonarr', 'radarr', 'home-assistant', 'node-red', 'mariadb'].includes(service.slug));
---
<figure class="command-visual">
  <div class="dashboard" role="img" aria-label="Command Center dashboard illustration with its real page names and service logos. Decorative bars do not represent live metrics or container health.">
    <aside class="sidebar" aria-hidden="true">
      <span class="app-mark">{'{ SOL }'}</span>
      <div class="side-pages">{pages.map((page, index) => <span class:list={{ selected: index === 0 }}>{page}</span>)}</div>
      <span class="side-foot">Command Center</span>
    </aside>
    <div class="dashboard-body">
      <div class="mock-heading"><span>Dashboard</span><span class="mock-note">DESIGN STUDY</span></div>
      <div class="stat-shapes" aria-hidden="true">{['System', 'Storage', 'GPU'].map(label => <div><span>{label}</span><i></i><i></i></div>)}</div>
      <div class="grid-heading">Container health <span>Illustration only</span></div>
      <div class="service-grid">{visibleServices.map(service => <div class="service"><img src={`/icons/services/${service.icon}`} width="32" height="32" alt={`${service.name} logo`} loading="lazy" /><span>{service.name}</span><i aria-hidden="true"></i></div>)}</div>
      <div class="bottom-panels" aria-hidden="true">
        <div class="activity"><span>Activity feed</span><i></i><i></i><i></i></div>
        <div class="gpu"><span>GPU panel</span><svg viewBox="0 0 150 48" fill="none"><path d="M0 35 14 32 28 39 42 22 56 25 70 10 84 19 98 15 112 29 126 8 150 17" stroke="currentColor" stroke-width="2" /></svg></div>
      </div>
    </div>
  </div>
  <figcaption>Interface illustration · real services, not live telemetry.</figcaption>
</figure>
<style>
  .command-visual { margin: 0; min-width: 0; }
  .dashboard { display: grid; grid-template-columns: 118px minmax(0, 1fr); border: 1px solid var(--line); border-radius: 14px; background: var(--panel); box-shadow: 0 24px 70px var(--ambient); overflow: hidden; transform: perspective(1200px) rotateY(-5deg) rotateX(2deg); }
  .sidebar { display: flex; flex-direction: column; padding: 22px 12px; background: var(--bg); border-right: 1px solid var(--line); font-size: 10px; }
  .app-mark { font-family: var(--font-mono); color: var(--accent); font-size: 15px; font-weight: 700; margin-bottom: 23px; }
  .side-pages { display: grid; gap: 6px; }
  .side-pages span { padding: 7px 8px; border-radius: 5px; color: var(--muted); }
  .side-pages .selected { color: var(--accent); background: var(--soft); }
  .side-foot { margin-top: auto; padding-top: 32px; color: var(--muted); font-size: 9px; }
  .dashboard-body { padding: 24px 18px; min-width: 0; }
  .mock-heading { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 15px; font-weight: 650; }
  .mock-note { font: 8px var(--font-mono); color: var(--muted); }
  .stat-shapes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 20px; }
  .stat-shapes div { padding: 12px; background: var(--soft); border-radius: 6px; }
  .stat-shapes span, .bottom-panels span { font-size: 9px; color: var(--muted); }
  .stat-shapes i { display: block; width: 65%; height: 6px; background: var(--line); margin-top: 11px; border-radius: 2px; }
  .stat-shapes i + i { width: 40%; height: 3px; background: var(--accent); opacity: .6; margin-top: 7px; }
  .grid-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 5px; font-size: 11px; margin: 23px 0 10px; }
  .grid-heading span { color: var(--muted); font-size: 9px; }
  .service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; }
  .service { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 12px 3px; border: 1px solid var(--line); border-radius: 6px; font-size: 9px; }
  .service img { width: 27px; height: 27px; object-fit: contain; }
  .service i { width: 22px; height: 2px; background: var(--line); }
  .bottom-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; }
  .bottom-panels > div { padding: 10px; border: 1px solid var(--line); border-radius: 5px; min-width: 0; }
  .activity i { display: block; height: 3px; background: var(--line); width: 80%; margin-top: 8px; }
  .activity i:nth-of-type(2) { width: 55%; }
  .gpu svg { display: block; margin-top: 7px; width: 100%; color: var(--accent); }
  figcaption { margin-top: 16px; font: 10px var(--font-mono); color: var(--muted); text-align: center; }
  @media (max-width: 600px) { .dashboard { grid-template-columns: 88px minmax(0, 1fr); transform: none; } .sidebar { padding: 18px 7px; font-size: 9px; } .side-pages span { padding: 7px 4px; } .dashboard-body { padding: 19px 10px; } .stat-shapes div { padding: 8px; } .mock-note { display: none; } .service { font-size: 8px; } }
</style>
