---
const routes = ['standings', 'results', 'qualifying', 'next race', 'live', 'predictions', 'head-to-head', 'battles'];
---
<figure class="race-visual">
  <div class="race-board" role="img" aria-label="Abstract F1 Dashboard illustration with a fictional track outline and real route names. This is not a race circuit, live race, or standings display.">
    <div class="race-heading"><span>F1 / DASHBOARD</span><span class="race-edition">INTERFACE STUDY</span></div>
    <div class="route-nav" aria-hidden="true">{routes.map((route, index) => <span class:list={{ active: index === 0 }}>{route}</span>)}</div>
    <div class="track-stage" aria-hidden="true">
      <svg viewBox="0 0 560 330" fill="none">
        <defs><pattern id="race-grid" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M28 0H0V28" stroke="currentColor" stroke-width=".5" /></pattern></defs>
        <rect width="560" height="330" fill="url(#race-grid)" class="track-grid" />
        <path class="track-shadow" d="M134 236C58 241 36 183 90 139L174 75C212 45 258 67 272 107L293 166C302 195 328 198 345 169L394 81C416 43 462 55 467 93L482 215C487 252 457 278 427 255L393 229C367 210 353 228 336 251L300 287C270 314 225 287 226 253L228 204C229 175 208 162 185 182Z" />
        <path class="track-line" pathLength="1" d="M134 236C58 241 36 183 90 139L174 75C212 45 258 67 272 107L293 166C302 195 328 198 345 169L394 81C416 43 462 55 467 93L482 215C487 252 457 278 427 255L393 229C367 210 353 228 336 251L300 287C270 314 225 287 226 253L228 204C229 175 208 162 185 182Z" />
        <path d="M104 223 124 245M110 219 130 241" stroke="var(--text)" stroke-width="2" />
        <circle cx="270" cy="106" r="5" fill="var(--text)" />
        <path d="M270 93V36H327" stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 4" />
        <text x="335" y="39" fill="var(--muted)" font-size="9" font-family="monospace">ABSTRACT CIRCUIT</text>
        <text x="28" y="311" fill="var(--muted)" font-size="9" font-family="monospace">NO LIVE RACE DATA</text>
      </svg>
    </div>
    <div class="race-footer"><span>Next.js / Prisma</span><span>Source → Docker</span></div>
  </div>
  <figcaption>Track illustration · real routes, no invented race results.</figcaption>
</figure>
<style>
  .race-visual { margin: 0; min-width: 0; }
  .race-board { border: 1px solid var(--line); background: linear-gradient(155deg, var(--soft), var(--bg) 65%); border-radius: 12px; overflow: hidden; }
  .race-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 22px 22px 15px; font: 700 13px var(--font-mono); letter-spacing: .08em; }
  .race-edition { color: var(--muted); font-size: 8px; font-weight: 400; }
  .route-nav { display: flex; flex-wrap: wrap; gap: 7px 12px; padding: 0 22px 16px; border-bottom: 1px solid var(--line); font: 9px var(--font-mono); color: var(--muted); }
  .route-nav .active { color: var(--accent); }
  .track-stage { padding: 8px; }
  .track-stage svg { display: block; width: 100%; }
  .track-grid { color: var(--line); opacity: .5; }
  .track-shadow { stroke: var(--accent); stroke-width: 18px; opacity: .07; }
  .track-line { stroke: var(--accent); stroke-width: 3px; stroke-linecap: round; stroke-linejoin: round; animation: trace-track 3s ease-out both; }
  .race-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 15px 22px; border-top: 1px solid var(--line); font: 9px var(--font-mono); color: var(--muted); }
  figcaption { margin-top: 16px; font: 10px var(--font-mono); color: var(--muted); text-align: center; }
  @keyframes trace-track { from { stroke-dasharray: 1; stroke-dashoffset: 1; } to { stroke-dasharray: 1; stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .track-line { animation: none; } }
  @media (max-width: 600px) { .race-heading { padding-inline: 16px; } .route-nav { padding-inline: 16px; } }
</style>
